<Window x:Class="POS.UI.Views.Customers.ClienteFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Customers"
        xmlns:enums="clr-namespace:POS.Domain.Enums;assembly=POS.Domain"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ClienteFormViewModel}"
        Title="{Binding Titulo}"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <ObjectDataProvider x:Key="TipoClienteEnum" MethodName="GetValues" ObjectType="{x:Type enums:TipoCliente}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TipoCliente"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TipoDocumentoEnum" MethodName="GetValues" ObjectType="{x:Type enums:TipoDocumento}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TipoDocumento"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ResponsabilidadFiscalEnum" MethodName="GetValues" ObjectType="{x:Type enums:ResponsabilidadFiscal}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:ResponsabilidadFiscal"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="RegimenTributarioEnum" MethodName="GetValues" ObjectType="{x:Type enums:RegimenTributario}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:RegimenTributario"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#673AB7" 
                CornerRadius="5" 
                Padding="20"
                Margin="0,0,0,20">
            <TextBlock Text="{Binding Titulo}"
                      FontSize="20"
                      FontWeight="Bold"
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Tipo de Cliente -->
                <Border Background="White"
                       BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="20"
                       Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="TIPO DE CLIENTE"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo de Cliente:" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource TipoClienteEnum}}"
                                         SelectedItem="{Binding TipoCliente}"
                                         Padding="10,8"
                                         FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tipo de Documento:" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource TipoDocumentoEnum}}"
                                         SelectedItem="{Binding TipoDocumento}"
                                         Padding="10,8"
                                         FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Identificación -->
                <Border Background="White"
                       BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="20"
                       Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="IDENTIFICACIÓN"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Número de Documento: *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nombre Completo: *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Razón Social (Persona Jurídica):" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nombre Comercial:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NombreComercial, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ubicación -->
                <Border Background="White"
                       BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="20"
                       Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="UBICACIÓN"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Departamento: *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ciudad: *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="Dirección: *" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                                    Padding="10,8"
                                    FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Contacto -->
                <Border Background="White"
                       BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="20"
                       Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="CONTACTO"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Email Principal: *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono Principal: *" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Email Secundario:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EmailSecundario, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono Secundario:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding TelefonoSecundario, UpdateSourceTrigger=PropertyChanged}"
                                        Padding="10,8"
                                        FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Datos Tributarios -->
                <Border Background="White"
                       BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="20"
                       Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="DATOS TRIBUTARIOS"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Responsabilidad Fiscal:" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource ResponsabilidadFiscalEnum}}"
                                         SelectedItem="{Binding ResponsabilidadFiscal}"
                                         Padding="10,8"
                                         FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Régimen Tributario:" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource RegimenTributarioEnum}}"
                                         SelectedItem="{Binding Regimen}"
                                         Padding="10,8"
                                         FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="Actividad Económica (CIIU):" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ActividadEconomica, UpdateSourceTrigger=PropertyChanged}"
                                    Padding="10,8"
                                    FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Observaciones -->
                <Border Background="White"
                       BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="20">
                    <StackPanel>
                        <TextBlock Text="OBSERVACIONES"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>
                        
                        <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10,8"
                                Height="80"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancelar"
                    Padding="0,15"
                    FontSize="16"
                    Background="#FFEBEE"
                    Foreground="#C62828"
                    BorderThickness="1"
                    BorderBrush="#EF9A9A"
                    Cursor="Hand"
                    Command="{Binding CancelarCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="5"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2"
                    Content="✅ GUARDAR"
                    Padding="0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding GuardarCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           CornerRadius="5"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Guardando..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>