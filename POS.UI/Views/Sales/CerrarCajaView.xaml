<Window x:Class="POS.UI.Views.Sales.CerrarCajaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:CerrarCajaViewModel}"
        Title="Cerrar Caja - Arqueo Final"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="#D32F2F" 
                    CornerRadius="5" 
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="🔒 CIERRE DE CAJA"
                              FontSize="20"
                              FontWeight="Bold"
                              Foreground="White"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Conte el efectivo físico y registre cada denominación"
                              FontSize="12"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              Margin="0,3,0,0"
                              Opacity="0.9"/>
                </StackPanel>
            </Border>

            <!-- Resumen del Sistema (más compacto) -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ventas -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📊 VENTAS"
                                  FontSize="12"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,8"/>
                        <Grid Margin="0,3">
                            <TextBlock Text="Total:" FontSize="11"/>
                            <TextBlock Text="{Binding TotalVentas, StringFormat=C}"
                                      FontSize="11" FontWeight="Bold"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Cantidad:" FontSize="11"/>
                            <TextBlock Text="{Binding CantidadVentas}"
                                      FontSize="11" FontWeight="Bold"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Efectivo Sistema -->
                    <StackPanel Grid.Column="1" Margin="15,0">
                        <TextBlock Text="💵 EFECTIVO"
                                  FontSize="12"
                                  FontWeight="Bold"
                                  Foreground="#FF9800"
                                  Margin="0,0,0,8"/>
                        <Grid Margin="0,3">
                            <TextBlock Text="Inicial:" FontSize="11"/>
                            <TextBlock Text="{Binding MontoInicial, StringFormat=C}"
                                      FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="+ Ventas:" FontSize="11"/>
                            <TextBlock Text="{Binding TotalVentasEfectivo, StringFormat=C}"
                                      FontSize="11" Foreground="Green"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="- Retiros:" FontSize="11"/>
                            <TextBlock Text="{Binding TotalRetiros, StringFormat=C}"
                                      FontSize="11" Foreground="Red"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,3"/>
                        <Grid Margin="0,3">
                            <TextBlock Text="ESPERADO:" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding EfectivoEsperado, StringFormat=C}"
                                      FontSize="12" FontWeight="Bold"
                                      Foreground="#FF9800"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Otros Métodos -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="💳 OTROS"
                                  FontSize="12"
                                  FontWeight="Bold"
                                  Foreground="#4CAF50"
                                  Margin="0,0,0,8"/>
                        <Grid Margin="0,3">
                            <TextBlock Text="Tarjeta:" FontSize="11"/>
                            <TextBlock Text="{Binding TotalTarjetaSistema, StringFormat=C}"
                                      FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Nequi:" FontSize="11"/>
                            <TextBlock Text="{Binding TotalNequiSistema, StringFormat=C}"
                                      FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Daviplata:" FontSize="11"/>
                            <TextBlock Text="{Binding TotalDaviplataSistema, StringFormat=C}"
                                      FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Arqueo Físico (más compacto) -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MONEDAS -->
                <Border Grid.Column="0" 
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="🪙 MONEDAS"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Monedas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                  Text="{Binding Nombre}"
                                                  FontSize="13"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1"
                                                Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                                FontSize="13"
                                                Padding="6"
                                                TextAlignment="Center"
                                                VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding Total, StringFormat=C}"
                                                  FontSize="13"
                                                  FontWeight="Bold"
                                                  Foreground="#673AB7"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8"/>

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="TOTAL:"
                                      FontSize="13"
                                      FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalMonedasContado, StringFormat=C}"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="#673AB7"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BILLETES -->
                <Border Grid.Column="2" 
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="💵 BILLETES"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Billetes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                  Text="{Binding Nombre}"
                                                  FontSize="13"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1"
                                                Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                                FontSize="13"
                                                Padding="6"
                                                TextAlignment="Center"
                                                VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding Total, StringFormat=C}"
                                                  FontSize="13"
                                                  FontWeight="Bold"
                                                  Foreground="#673AB7"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8"/>

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="TOTAL:"
                                      FontSize="13"
                                      FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalBilletesContado, StringFormat=C}"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="#673AB7"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Resumen de Diferencia (más compacto) -->
            <Border Grid.Row="3"
                    Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#E8F5E9"/>
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HayFaltante}" Value="True">
                                <Setter Property="Background" Value="#FFEBEE"/>
                                <Setter Property="BorderBrush" Value="#F44336"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HaySobrante}" Value="True">
                                <Setter Property="Background" Value="#FFF3E0"/>
                                <Setter Property="BorderBrush" Value="#FF9800"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.BorderThickness>2</Border.BorderThickness>
                <Border.CornerRadius>5</Border.CornerRadius>
                <Border.Padding>15</Border.Padding>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="ESPERADO"
                                  FontSize="11"
                                  Foreground="Gray"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EfectivoEsperado, StringFormat=C}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="CONTADO"
                                  FontSize="11"
                                  Foreground="Gray"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalEfectivoContado, StringFormat=C}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock FontSize="11"
                                  Foreground="Gray"
                                  HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="DIFERENCIA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HayFaltante}" Value="True">
                                            <Setter Property="Text" Value="⚠️ FALTANTE"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HaySobrante}" Value="True">
                                            <Setter Property="Text" Value="⚠️ SOBRANTE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DiferenciaEfectivo, StringFormat=C}"
                                  FontSize="22"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HayFaltante}" Value="True">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HaySobrante}" Value="True">
                                            <Setter Property="Foreground" Value="#FF9800"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Botones -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Padding="0,12"
                        FontSize="14"
                        Background="#FFEBEE"
                        Foreground="#C62828"
                        BorderThickness="1"
                        BorderBrush="#EF9A9A"
                        Cursor="Hand"
                        Command="{Binding CancelarCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2"
                        Content="🔒 CERRAR CAJA E IMPRIMIR"
                        Padding="0,12"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#D32F2F"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding CerrarCajaCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C62828"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#CCCCCC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Loading Overlay -->
            <Border Grid.Row="0"
                    Grid.RowSpan="5"
                    Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⏳"
                              FontSize="48"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Cerrando caja..."
                              FontSize="18"
                              Foreground="White"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>