<Window x:Class="POS.UI.Views.Sales.ProcesarPagoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ProcesarPagoViewModel}"
        Title="Procesar Pago" 
        Height="650" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4CAF50">
            <Grid Margin="30,0">
                <TextBlock Text="💰 PROCESAR PAGO" 
                          FontSize="22" 
                          FontWeight="Bold" 
                          Foreground="White"
                          VerticalAlignment="Center"/>
                
                <TextBlock Text="{Binding Total, StringFormat='Total: {0:C}'}" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Métodos de Pago -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">

                <!-- Efectivo -->
                <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💵 Efectivo" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtEfectivo"
                                Text="{Binding MontoEfectivo, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                FontSize="18"
                                Padding="10,8"
                                TabIndex="1"
                                GotFocus="TextBox_GotFocus"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta -->
                <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💳 Tarjeta" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MontoTarjeta, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                FontSize="18"
                                Padding="10,8"
                                TabIndex="2"
                                GotFocus="TextBox_GotFocus"/>
                    </StackPanel>
                </Border>

                <!-- Nequi -->
                <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📱 Nequi" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MontoNequi, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                FontSize="18"
                                Padding="10,8"
                                TabIndex="3"
                                GotFocus="TextBox_GotFocus"/>
                    </StackPanel>
                </Border>

                <!-- Daviplata -->
                <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📱 Daviplata" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MontoDaviplata, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                FontSize="18"
                                Padding="10,8"
                                TabIndex="4"
                                GotFocus="TextBox_GotFocus"/>
                    </StackPanel>
                </Border>

                <!-- Transferencia -->
                <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🏦 Transferencia" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MontoTransferencia, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                FontSize="18"
                                Padding="10,8"
                                TabIndex="5"
                                GotFocus="TextBox_GotFocus"/>
                    </StackPanel>
                </Border>

                <!-- QR -->
                <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📲 QR Bancolombia" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MontoQR, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                FontSize="18"
                                Padding="10,8"
                                TabIndex="6"
                                GotFocus="TextBox_GotFocus"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Resumen de Pago -->
        <Border Grid.Row="2"
               Background="White"
               BorderBrush="#E0E0E0"
               BorderThickness="0,1,0,1"
               Padding="30,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock Text="💵 Total Pagado:" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalPagado, StringFormat=C}" 
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#4CAF50"
                              HorizontalAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <TextBlock Text="⚠️ Falta por Pagar:" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FaltaPorPagar, StringFormat=C}" 
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#F44336"
                              HorizontalAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="2">
                    <TextBlock Text="💸 Cambio:" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Cambio, StringFormat=C}" 
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#FF9800"
                              HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer con botones -->
        <Border Grid.Row="3" 
               Background="White" 
               Padding="30,0">
            <Grid>
                <!-- Mensaje de error -->
                <Border Background="#FFEBEE"
                       BorderBrush="#EF5350"
                       BorderThickness="1"
                       CornerRadius="3"
                       Padding="10"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                              Foreground="#C62828"
                              FontSize="12"
                              MaxWidth="300"
                              TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar (ESC)"
                           Width="150"
                           Height="45"
                           Margin="0,0,10,0"
                           FontSize="14"
                           Background="#E0E0E0"
                           BorderThickness="0"
                           Cursor="Hand"
                           Click="Cancelar_Click"/>

                    <Button Content="COMPLETAR VENTA (F12)"
                           Width="220"
                           Height="45"
                           FontSize="14"
                           FontWeight="Bold"
                           Background="#4CAF50"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"
                           Command="{Binding CompletarVentaCommand}"
                           IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Height="3"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>