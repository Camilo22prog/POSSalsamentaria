<Window x:Class="POS.UI.Views.Sales.AbrirCajaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AbrirCajaViewModel}"
        Title="Abrir Caja - Arqueo Inicial"
        Height="750"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#673AB7" 
                CornerRadius="5" 
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="💰 APERTURA DE CAJA"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Ingrese la cantidad de cada denominación"
                          FontSize="14"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"
                          Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- Denominaciones -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MONEDAS -->
            <Border Grid.Column="0" 
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="🪙 MONEDAS"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#673AB7"
                              Margin="0,0,0,15"/>

                    <ItemsControl ItemsSource="{Binding Monedas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                              Text="{Binding Nombre}"
                                              FontSize="16"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                            Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="16"
                                            Padding="10,8"
                                            TextAlignment="Center"
                                            VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                              Text="{Binding Total, StringFormat=C}"
                                              FontSize="16"
                                              FontWeight="Bold"
                                              Foreground="#673AB7"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,15"/>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="TOTAL MONEDAS:"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalMonedas, StringFormat=C}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BILLETES -->
            <Border Grid.Column="2" 
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="💵 BILLETES"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#673AB7"
                              Margin="0,0,0,15"/>

                    <ItemsControl ItemsSource="{Binding Billetes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                              Text="{Binding Nombre}"
                                              FontSize="16"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                            Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="16"
                                            Padding="10,8"
                                            TextAlignment="Center"
                                            VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                              Text="{Binding Total, StringFormat=C}"
                                              FontSize="16"
                                              FontWeight="Bold"
                                              Foreground="#673AB7"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,15"/>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="TOTAL BILLETES:"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalBilletes, StringFormat=C}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="#673AB7"
                                  HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Total General -->
        <Border Grid.Row="2"
                Background="#EDE7F6"
                BorderBrush="#673AB7"
                BorderThickness="2"
                CornerRadius="5"
                Padding="20"
                Margin="0,20,0,0">
            <Grid>
                <TextBlock Text="MONTO INICIAL:"
                          FontSize="22"
                          FontWeight="Bold"
                          Foreground="#673AB7"/>
                <TextBlock Text="{Binding TotalGeneral, StringFormat=C}"
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="#673AB7"
                          HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancelar"
                    Padding="0,15"
                    FontSize="16"
                    Background="#FFEBEE"
                    Foreground="#C62828"
                    BorderThickness="1"
                    BorderBrush="#EF9A9A"
                    Cursor="Hand"
                    Command="{Binding CancelarCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="5"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2"
                    Content="✅ ABRIR CAJA"
                    Padding="0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding AbrirCajaCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           CornerRadius="5"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
                Grid.RowSpan="4"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Abriendo caja..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>