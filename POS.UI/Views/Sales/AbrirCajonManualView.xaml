<Window x:Class="POS.UI.Views.Sales.AbrirCajonManualView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AbrirCajonManualViewModel}"
        Title="Abrir Cajón"
        Height="420"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#673AB7"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🔓 ABRIR CAJÓN"
                           FontSize="18" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Requiere autorización de administrador o supervisor"
                           FontSize="11" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="1"
                Background="White" CornerRadius="6" Padding="18"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Usuario:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,18">
                    <TextBox Text="{Binding UsuarioAutorizador, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8" BorderThickness="0"
                             x:Name="TxtUsuario"/>
                </Border>

                <TextBlock Text="Contraseña:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="4">
                    <PasswordBox x:Name="PbPassword"
                                 FontSize="14" Padding="10,8"
                                 BorderThickness="0"
                                 PasswordChanged="PbPassword_PasswordChanged"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cancelar"
                    Padding="0,11" FontSize="13"
                    Background="#FFEBEE" Foreground="#C62828"
                    BorderThickness="1" BorderBrush="#EF9A9A"
                    Cursor="Hand" Command="{Binding CancelarCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Content="🔓 ABRIR CAJÓN"
                    Padding="0,11" FontSize="13" FontWeight="Bold"
                    Background="#673AB7" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding ValidarYAbrirCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#512DA8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Verificando..." FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
