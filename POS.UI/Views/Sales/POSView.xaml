<UserControl x:Class="POS.UI.Views.Sales.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Sales"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:POSViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="White">

    <!-- ✅ ATAJOS DE TECLADO GLOBALES -->
    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding AgregarProductoCommand}"/>
        <KeyBinding Key="F2" Command="{Binding BuscarProductoCommand}"/>
        <KeyBinding Key="F3" Command="{Binding BuscarClienteCommand}"/>
        <KeyBinding Key="F4" Command="{Binding EliminarProductoCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ProcesarPagoCommand}"/>
        <!-- ✅ F6 para productos por peso -->
        <KeyBinding Key="F6" Command="{Binding AbrirProductosPorPesoCommand}"/>
        <KeyBinding Key="F8" Command="{Binding AnularVentaCommand}"/>
        <KeyBinding Key="F9" Command="{Binding AbrirCajaCommand}"/>
        <KeyBinding Key="F10" Command="{Binding CerrarCajaCommand}"/>
        <KeyBinding Key="F12" Command="{Binding NuevaPestanaCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛒" FontSize="28" Margin="0,0,10,0" />
                    <TextBlock Text="PUNTO DE VENTA (SUPERMERCADO)"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding NombreUsuario}"
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl -->
        <Grid Grid.Row="1">
            <TabControl ItemsSource="{Binding Pestanas}"
                        SelectedItem="{Binding PestanaActiva}"
                        Padding="0"
                        BorderThickness="0">

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Titulo}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <Button Content="✖"
                                    Margin="10,0,0,0"
                                    Padding="5,0"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="Red"
                                    Cursor="Hand"
                                    Command="{Binding CancelarVentaCommand}"
                                    ToolTip="Cerrar pestaña" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ===== FILA 0: BUSQUEDA ===== -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Campo búsqueda -->
                                <Border Grid.Row="0"
                                        Background="#ECEFF1"
                                        Padding="15"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="TxtBusqueda"
                                                    Text="{Binding CodigoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                                    FontSize="16"
                                                    Padding="15,10"
                                                    VerticalContentAlignment="Center"
                                                    BorderThickness="2"
                                                    BorderBrush="#2C3E50"
                                                    Background="White"
                                                    Loaded="TxtBusqueda_Loaded">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding BuscarYAgregarProductoCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>

                                            <TextBlock Text="🔍 Código de barras o nombre del producto (Enter para agregar)"
                                                    Foreground="Gray"
                                                    FontSize="13"
                                                    Margin="20,0,0,0"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CodigoBusqueda}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Agregar (Enter)"
                                                    Padding="20,10"
                                                    Margin="10,0,0,0"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Background="#2C3E50"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding BuscarYAgregarProductoCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="5"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#34495E"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            
                                            <!-- ✅ BOTÓN PESO CON F6 -->
                                            <Button Content="⚖️ PESO (F6)"
                                                    Padding="15,10"
                                                    Margin="10,0,0,0"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Background="#FF9800"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Productos por peso - F6"
                                                    Command="{Binding DataContext.AbrirProductosPorPesoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F57C00"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Lista preview resultados -->
                                <Border Grid.Row="1"
                                        Background="White"
                                        BorderBrush="#2C3E50"
                                        BorderThickness="2"
                                        CornerRadius="0,0,8,8"
                                        Margin="15,-2,15,0"
                                        Panel.ZIndex="100"
                                        Visibility="{Binding MostrarResultados, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                                    </Border.Effect>
                                    <ListView x:Name="ListResultados"
                                              ItemsSource="{Binding ResultadosBusqueda}"
                                              MaxHeight="250"
                                              BorderThickness="0"
                                              Background="White"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,8"
                                                        Cursor="Hand"
                                                        Background="Transparent">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SeleccionarProductoDeListaCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Codigo}"
                                                                   FontSize="12"
                                                                   Foreground="Gray"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Nombre}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding PrecioVenta, StringFormat=C}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="#2C3E50"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding StockActual, StringFormat='Stock: {0:N0}'}"
                                                                   FontSize="12"
                                                                   Foreground="Gray"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>

                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="BorderBrush" Value="#F0F0F0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </Border>

                                <!-- Alerta producto no encontrado -->
                                <Border Grid.Row="2"
                                        Background="#FFEBEE"
                                        BorderBrush="#EF5350"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="12,8"
                                        Margin="0,5,0,0"
                                        Visibility="{Binding ProductoNoEncontrado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️"
                                                   FontSize="16"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MensajeError}"
                                                   Foreground="#C62828"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- ===== FIN FILA 0 ===== -->

                            <!-- ===== FILA 1: CLIENTE + CARRITO + TOTALES ===== -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- FILA 0: chip de cliente (solo visible cuando hay cliente seleccionado) -->
                                <Border Grid.Row="0"
                                        Margin="0,0,0,6"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        Background="#ECEFF1"
                                        BorderBrush="#B0BEC5" BorderThickness="1"
                                        Visibility="{Binding ClienteSeleccionado, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👤" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClienteSeleccionado.NombreCompleto}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                            <TextBlock Text="{Binding ClienteSeleccionado.NumeroDocumento, StringFormat=' · {0}'}"
                                                       FontSize="11" Foreground="#546E7A" Margin="3,0,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="✕" Width="20" Height="20"
                                                FontSize="10" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#546E7A" Cursor="Hand"
                                                ToolTip="Quitar cliente"
                                                Command="{Binding LimpiarClienteCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#CFD8DC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ===== FILA 1: CARRITO + TOTALES ===== -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>

                                    <!-- COLUMNA 0: Carrito -->
                                    <Border Grid.Column="0"
                                            BorderBrush="#B0BEC5"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,0,10,0">
                                        <Grid>
                                            <DataGrid ItemsSource="{Binding Items}"
                                                      SelectedItem="{Binding ItemSeleccionado}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionMode="Single"
                                                      GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column"
                                                      RowHeight="52"
                                                      FontSize="15"
                                                      Background="White"
                                                      BorderThickness="0"
                                                      CanUserReorderColumns="False"
                                                      CanUserResizeColumns="False"
                                                      CanUserSortColumns="False">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#2C3E50" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Padding" Value="10,12" />
                                                        <Setter Property="FontSize" Value="14" />
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
 
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#ECEFF1" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
 
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
                                                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnitario, StringFormat=C}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,10,0" />
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat=N2}" Width="80">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,10,0" />
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="IVA%" Binding="{Binding PorcentajeIVA, StringFormat=N0}" Width="70">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Center" />
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="IVA $" Binding="{Binding MontoIVA, StringFormat=C}" Width="100">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,10,0" />
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="130">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,10,0" />
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
 
                                            <!-- Mensaje carrito vacío -->
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding CarritoVacio, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                <TextBlock Text="🛒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                <TextBlock Text="Carrito vacío"
                                                           FontSize="18"
                                                           Foreground="Gray"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Escanee o busque un producto"
                                                           FontSize="14"
                                                           Foreground="#BDBDBD"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
 
                                    <!-- COLUMNA 1: Totales -->
                                    <Border Grid.Column="1"
                                            Background="#FAFAFA"
                                            BorderBrush="#2C3E50"
                                            BorderThickness="4,1,1,1"
                                            CornerRadius="5"
                                            Padding="20">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="RESUMEN DE VENTA"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#2C3E50"
                                                       Margin="0,0,0,20" />
 
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Subtotal:" FontSize="15" Foreground="Gray" />
                                                <TextBlock Text="{Binding Subtotal, StringFormat=C}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
 
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="IVA incluido:" FontSize="15" Foreground="Gray" />
                                                <TextBlock Text="{Binding IvaTotal, StringFormat=C}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E65100"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
 
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Descuento:" FontSize="15" Foreground="Gray" />
                                                <TextBlock Text="{Binding DescuentoTotal, StringFormat=C}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="Red"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
 
                                            <Separator Margin="0,10" />
 
                                            <Grid Margin="0,5,0,0">
                                                <TextBlock Text="TOTAL:" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Total, StringFormat=C}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Foreground="#2E7D32"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
 
                                            <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} producto(s) en carrito', Mode=OneWay}"
                                                       Margin="0,5,0,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="Gray"
                                                       FontSize="12" />
 
                                            <!-- Botón Pagar -->
                                            <Button Content="💰 PROCESAR PAGO (F12)"
                                                    Margin="0,25,0,0"
                                                    Padding="0,20"
                                                    FontSize="17"
                                                    FontWeight="Bold"
                                                    Background="#2E7D32"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding ProcesarPagoCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="8"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#1B5E20" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#CCCCCC" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
 
                                            <!-- Botón Cancelar -->
                                            <Button Content="🗑️ Cancelar Venta (F5)"
                                                    Margin="0,10,0,0"
                                                    Padding="0,10"
                                                    FontSize="13"
                                                    Background="#FFEBEE"
                                                    Foreground="#C62828"
                                                    BorderThickness="1"
                                                    BorderBrush="#EF9A9A"
                                                    Cursor="Hand"
                                                    Command="{Binding CancelarVentaCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="5"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FFCDD2" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- ===== FIN FILA 1 ===== -->

                            <!-- Grid.Row="2" - Barra de atajos Y gestión de caja -->
                            <Border Grid.Row="2"
                                    Background="#F8F9FA"
                                    BorderBrush="#CFD8DC"
                                    BorderThickness="0,1,0,0"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ✅ ATAJOS ACTUALIZADOS COMO KEYCAPS -->
                                    <WrapPanel Grid.Column="0"
                                               Orientation="Horizontal"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <Border Background="#ECEFF1" BorderBrush="#B0BEC5" BorderThickness="1,1,2,2" CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="F1" FontWeight="Bold" FontSize="11" Foreground="#37474F"/>
                                            </Border>
                                            <TextBlock Text=" Buscar" FontSize="13" VerticalAlignment="Center" Foreground="#37474F"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <Border Background="#ECEFF1" BorderBrush="#B0BEC5" BorderThickness="1,1,2,2" CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="F4" FontWeight="Bold" FontSize="11" Foreground="#37474F"/>
                                            </Border>
                                            <TextBlock Text=" Quitar" FontSize="13" VerticalAlignment="Center" Foreground="#37474F"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <Border Background="#ECEFF1" BorderBrush="#B0BEC5" BorderThickness="1,1,2,2" CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="F5" FontWeight="Bold" FontSize="11" Foreground="#37474F"/>
                                            </Border>
                                            <TextBlock Text=" Cancelar" FontSize="13" VerticalAlignment="Center" Foreground="#37474F"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1,1,2,2" CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="F6" FontWeight="Bold" FontSize="11" Foreground="#E65100"/>
                                            </Border>
                                            <TextBlock Text=" Peso ⚖️" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="#E65100"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1,1,2,2" CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="F12" FontWeight="Bold" FontSize="11" Foreground="#2E7D32"/>
                                            </Border>
                                            <TextBlock Text=" Pagar" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2E7D32"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <Border Background="#ECEFF1" BorderBrush="#B0BEC5" BorderThickness="1,1,2,2" CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="+/-" FontWeight="Bold" FontSize="11" Foreground="#37474F"/>
                                            </Border>
                                            <TextBlock Text=" Cant." FontSize="13" VerticalAlignment="Center" Foreground="#37474F"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <Border Background="#ECEFF1" BorderBrush="#B0BEC5" BorderThickness="1,1,2,2" CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="Ctrl+N" FontWeight="Bold" FontSize="11" Foreground="#37474F"/>
                                            </Border>
                                            <TextBlock Text=" Nueva" FontSize="13" VerticalAlignment="Center" Foreground="#37474F"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- Gestión de caja (derecha) -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <!-- Botón ABRIR CAJA (visible solo si NO hay caja abierta) -->
                                        <Button Content="🔓 ABRIR CAJA"
                                                Padding="18,8"
                                                Margin="0,0,10,0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Background="#E8F5E9"
                                                Foreground="#2E7D32"
                                                BorderThickness="1.5"
                                                BorderBrush="#81C784"
                                                Cursor="Hand"
                                                Visibility="{Binding DataContext.TieneCajaAbierta, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.AbrirCajaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C8E6C9" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Botón Retiro de Caja (visible solo si HAY caja abierta) -->
                                        <Button Content="💰 RETIRO DE CAJA"
                                                Padding="18,8"
                                                Margin="0,0,10,0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Background="#FFF3E0"
                                                Foreground="#E65100"
                                                BorderThickness="1.5"
                                                BorderBrush="#FFB74D"
                                                Cursor="Hand"
                                                Visibility="{Binding DataContext.TieneCajaAbierta, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.RegistrarRetiroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFE0B2" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Botón Cerrar Caja (visible solo si HAY caja abierta) -->
                                        <Button Content="🔒 CERRAR CAJA"
                                                Padding="18,8"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Background="#FFEBEE"
                                                Foreground="#C62828"
                                                BorderThickness="1.5"
                                                BorderBrush="#EF5350"
                                                Cursor="Hand"
                                                Visibility="{Binding DataContext.TieneCajaAbierta, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.CerrarCajaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFCDD2" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- ===== FIN FILA 2 ===== -->
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Botón Nueva Pestaña -->
            <Button Content="＋ Nueva Venta"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="0,8,10,0"
                    Padding="15,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#2C3E50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding NuevaPestanaCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34495E" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — Caja no abierta
             Cubre toda la vista hasta que el usuario abra la caja.
             Panel.ZIndex garantiza que quede por encima de todo.
        ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Panel.ZIndex="99"
              Visibility="{Binding TieneCajaAbierta,
                           Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <!-- Fondo oscuro -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0101030" Offset="0"/>
                        <GradientStop Color="#F01A1A3E" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Tarjeta central -->
            <Border MaxWidth="500"
                    Background="White"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.45"
                                      BlurRadius="50" ShadowDepth="12"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Franja de acento superior roja -->
                    <Border Grid.Row="0" CornerRadius="20,20,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E74C3C" Offset="0"/>
                                <GradientStop Color="#C0392B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Contenido -->
                    <StackPanel Grid.Row="1" Margin="48,38,48,48" HorizontalAlignment="Center">

                        <!-- Ícono de caja cerrada -->
                        <Border Width="100" Height="100" CornerRadius="50"
                                HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFEBEE" Offset="0"/>
                                    <GradientStop Color="#FFCDD2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#E74C3C" Opacity="0.30"
                                                  BlurRadius="22" ShadowDepth="0"/>
                            </Border.Effect>
                            <TextBlock Text="🔒" FontSize="46"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Título -->
                        <TextBlock Text="Caja no abierta"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#1A1A2E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Descripción -->
                        <TextBlock FontSize="14" Foreground="#546E7A"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,28">
                            Debes abrir la caja registradora antes&#x0a;de comenzar a registrar ventas.
                        </TextBlock>

                        <!-- Chip de usuario -->
                        <Border Background="#F4F6F8" CornerRadius="12"
                                Padding="18,12" Margin="0,0,0,28"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="#EDE7F6" Margin="0,0,12,0">
                                    <TextBlock Text="👤" FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NombreUsuario}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="Necesita caja abierta para operar"
                                               FontSize="11" Foreground="#95A5A6"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Botón principal ABRIR CAJA -->
                        <Button Command="{Binding AbrirCajaCommand}"
                                Height="54" Cursor="Hand"
                                BorderThickness="0"
                                Margin="0,0,0,16">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            CornerRadius="12"
                                            Height="{TemplateBinding Height}"
                                            MinWidth="300">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#2ECC71" Offset="0"/>
                                                <GradientStop Color="#27AE60" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#27AE60" Opacity="0.45"
                                                              BlurRadius="18" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="🔓" FontSize="22"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Text="ABRIR CAJA AHORA"
                                                       FontSize="17" FontWeight="Bold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#27AE60" Offset="0"/>
                                                        <GradientStop Color="#1E8449" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="#1A6B37"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Atajo de teclado -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Atajo de teclado: "
                                       FontSize="12" Foreground="#BDC3C7"
                                       VerticalAlignment="Center"/>
                            <Border Background="#ECEFF1" CornerRadius="6"
                                    Padding="10,4">
                                <TextBlock Text="F9"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#546E7A"
                                           FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- FIN OVERLAY -->

    </Grid>
</UserControl>