<UserControl x:Class="POS.UI.Views.Dashboards.DashboardHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Dashboards"
             xmlns:helpers="clr-namespace:POS.UI.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardHubViewModel}"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#F5F5F5"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="TabBtnBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF5FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── Barra de navegación ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="White" Padding="16,12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,24,0">
                    <TextBlock Text="📊" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="Dashboards" FontSize="18" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Principal -->
                    <Button Command="{Binding NavegarPrincipalCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsPrincipalActivo}" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" Principal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Ventas -->
                    <Button Command="{Binding NavegarVentasCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsVentasActivo}" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" Ventas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Inventario -->
                    <Button Command="{Binding NavegarInventarioCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsInventarioActivo}" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" Inventario" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Financiero — visible solo si PuedeVerCostos (Admin / Supervisor) -->
                    <Button Command="{Binding NavegarFinancieroCommand}"
                            Visibility="{Binding PuedeVerFinanciero, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsFinancieroActivo}" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💼" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" Financiero" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── Contenido del dashboard activo ──────────────────────────────── -->
        <ContentControl Grid.Row="1" Content="{Binding ContenidoActual}"/>

    </Grid>
</UserControl>
