<UserControl x:Class="POS.UI.Views.Dashboards.DashboardInventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Dashboards"
             xmlns:helpers="clr-namespace:POS.UI.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardInventarioViewModel}"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F5F5F5"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Loading overlay -->
        <Border Panel.ZIndex="99"
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="⏳ Cargando..." FontSize="18" FontWeight="Bold" Foreground="#27AE60"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ─── Encabezado ───────────────────────────────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📦 Dashboard de Inventario"
                                   FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Estado actual del stock por categoría y productos críticos"
                                   FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 Actualizar"
                            Command="{Binding CargarDashboardCommand}"
                            Padding="18,10" FontSize="13" FontWeight="SemiBold"
                            Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ─── KPIs ─────────────────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📋 Total productos" FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Datos.TotalProductos}" FontSize="30" FontWeight="Bold"
                                       Foreground="#2C3E50" Margin="0,8,0,4"/>
                            <TextBlock Text="activos en catálogo" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="✅ Con stock" FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Datos.ProductosConStock}" FontSize="30" FontWeight="Bold"
                                       Foreground="#27AE60" Margin="0,8,0,4"/>
                            <TextBlock Text="tienen unidades disponibles" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⚠️ Stock bajo" FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Datos.ProductosStockBajo}" FontSize="30" FontWeight="Bold"
                                       Foreground="#E67E22" Margin="0,8,0,4"/>
                            <TextBlock Text="por debajo del mínimo" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🚨 Sin stock" FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Datos.ProductosSinStock}" FontSize="30" FontWeight="Bold"
                                       Foreground="#E74C3C" Margin="0,8,0,4"/>
                            <TextBlock Text="agotados completamente" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                        <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="💵 Valor en stock" FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Datos.ValorTotalInventario, StringFormat=C}"
                                       FontSize="22" FontWeight="Bold" Foreground="#9B59B6" Margin="0,8,0,4"/>
                            <TextBlock Text="costo total inventario" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─── Gráfico stock + Top rotados ──────────────────────────── -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bar chart por categoría -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="260"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📊 Valor en stock por categoría"
                                       FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>
                            <lvc:CartesianChart Grid.Row="1"
                                               Series="{Binding SeriesStock}"
                                               XAxes="{Binding AxisXStock}"/>
                        </Grid>
                    </Border>

                    <!-- Top rotados del mes -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                        <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🔄 Más vendidos (mes actual)"
                                       FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Datos.ProductosMasRotados}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6" Background="#F8FAFB">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#2C3E50" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" Foreground="Gray">
                                                        <Run Text="{Binding CantidadVendida, Mode=OneWay}"/>
                                                        <Run Text=" uds."/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=C}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#27AE60"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ─── Productos críticos ────────────────────────────────────── -->
                <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="20">
                    <Border.Effect><DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🚨 Productos con stock crítico o bajo"
                                   FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,14"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Datos.ProductosCriticos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="14" Margin="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoStock}" Value="Sin stock">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstadoStock}" Value="Crítico">
                                                        <Setter Property="Background" Value="#FBE9E7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding EstadoStock}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstadoStock}" Value="Sin stock">
                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoStock}" Value="Crítico">
                                                                <Setter Property="Foreground" Value="#C0392B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="Bold"
                                                       Foreground="#2C3E50" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Categoria}" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#E67E22"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoStock}" Value="Sin stock">
                                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Stock: "/>
                                                    <Run Text="{Binding StockActual, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="Gray" Margin="6,0,0,0">
                                                    <Run Text="/ mín: "/>
                                                    <Run Text="{Binding StockMinimo, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
