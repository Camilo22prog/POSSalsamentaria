<Window x:Class="POS.UI.Views.Catalog.ProductoFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Catalog"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ProductoFormViewModel}"
        Title="{Binding Titulo}"
        Height="820"
        Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#673AB7">
            <TextBlock Text="{Binding Titulo}" 
                      FontSize="22" 
                      FontWeight="Bold" 
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="30,0"/>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">

                <!-- Código -->
                <TextBlock Text="Código *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Margin="0,0,0,15"/>

                <!-- Nombre -->
                <TextBlock Text="Nombre *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Margin="0,0,0,15"/>

                <!-- Descripción -->
                <TextBlock Text="Descripción" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Height="60"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,15"/>

                <!-- Categoría -->
                <TextBlock Text="Categoría *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Categorias}"
                         SelectedValue="{Binding CategoriaId}"
                         DisplayMemberPath="Nombre"
                         SelectedValuePath="Id"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,15"/>

                <!-- Proveedor -->
                <TextBlock Text="Proveedor" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Proveedores}"
                         SelectedValue="{Binding ProveedorId}"
                         DisplayMemberPath="Nombre"
                         SelectedValuePath="Id"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,15"/>

                <!-- Tipo de Unidad y Tipo IVA -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tipo de Unidad -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo de Unidad *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TiposUnidad}"
                                 SelectedValue="{Binding TipoUnidad}"
                                 DisplayMemberPath="Texto"
                                 SelectedValuePath="Valor"
                                 FontSize="14"
                                 Padding="10,8"/>
                    </StackPanel>

                    <!-- Tipo IVA -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="IVA *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TiposIVA}"
                                 SelectedValue="{Binding TipoIVA}"
                                 DisplayMemberPath="Texto"
                                 SelectedValuePath="Valor"
                                 FontSize="14"
                                 Padding="10,8"/>
                    </StackPanel>
                </Grid>

                <!-- ✅ SECCIÓN VENTA POR PESO -->
                <Border Background="#FFF3E0"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15"
                        Visibility="{Binding MostrarCamposPeso, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="⚖️ CONFIGURACIÓN DE VENTA POR PESO" 
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#E65100"
                                  Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Categoría de Peso -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Categoría de Peso *" 
                                        Foreground="Gray"
                                        FontSize="12"
                                        Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding CategoriasPeso}"
                                        SelectedValue="{Binding CategoriaPeso}"
                                        SelectedValuePath="Valor"
                                        Height="40"
                                        FontSize="14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icono}" 
                                                        FontSize="16"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Nombre}" 
                                                        FontSize="14"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Precio por Kilo -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio por Kilo *" 
                                          Foreground="Gray"
                                          FontSize="12"
                                          Margin="0,0,0,5"/>
                                <TextBox Text="{Binding PrecioPorKilo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                        Height="40"
                                        VerticalContentAlignment="Center"
                                        FontSize="14"
                                        Padding="10,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- CheckBox Venta por Peso -->
                        <CheckBox IsChecked="{Binding VentaPorPeso}"
                                 Content="Habilitar venta por peso en el módulo de ventas"
                                 FontSize="13"
                                 Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <!-- ✅ FIN SECCIÓN VENTA POR PESO -->

                <!-- ══ SECCIÓN PRECIOS Y MÁRGENES ══ -->
                <Border Background="#F3E5F5"
                        BorderBrush="#CE93D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>

                        <TextBlock Text="💰 PRECIOS Y MÁRGENES"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#6A1B9A"
                                   Margin="0,0,0,14"/>

                        <!-- Fila 1: Precio Compra sin IVA | Precio Compra con IVA -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio Compra (sin IVA)"
                                           FontSize="11"
                                           Foreground="#6A1B9A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PrecioCompra, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         FontSize="14"
                                         Padding="10,8"
                                         ToolTip="Base de costo antes de impuesto. Los demás campos se calculan desde aquí."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio Compra (con IVA)"
                                           FontSize="11"
                                           Foreground="#6A1B9A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PrecioCompraConIVA, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         FontSize="14"
                                         Padding="10,8"
                                         ToolTip="Si ingresa este valor, el precio sin IVA se recalcula automáticamente."/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila 2: Margen (%) | Precio de Venta Sugerido (solo lectura) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Margen de Ganancia (%)"
                                           FontSize="11"
                                           Foreground="#6A1B9A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding MargenGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         FontSize="14"
                                         Padding="10,8"
                                         ToolTip="Modifique para recalcular el precio sugerido. Se actualiza automáticamente al cambiar el precio final."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio de Venta Sugerido"
                                           FontSize="11"
                                           Foreground="#2E7D32"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <!-- Solo lectura: borde verde, no es TextBox editable -->
                                <Border Background="#E8F5E9"
                                        BorderBrush="#A5D6A7"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,9">
                                    <Grid>
                                        <TextBlock Text="{Binding PrecioVentaSugerido, StringFormat=C}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#2E7D32"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="calculado automáticamente"
                                                   FontSize="10"
                                                   Foreground="#66BB6A"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Separador -->
                        <Separator Margin="0,0,0,12" Background="#CE93D8"/>

                        <!-- Fila 3: Precio de Venta Final (ancho completo, destacado) -->
                        <TextBlock Text="Precio de Venta Final *"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#4A148C"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Padding="10,10"
                                 BorderBrush="#9C27B0"
                                 BorderThickness="2"
                                 ToolTip="Precio final al cliente. Al modificarlo se recalcula el margen de ganancia real."/>

                        <!-- Indicador de margen real -->
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="#7B1FA2">
                            <Run Text="Margen real: "/>
                            <Run Text="{Binding MargenGanancia, StringFormat='{}{0:N1}%'}"
                                 FontWeight="Bold"/>
                            <Run Text=" sobre precio de compra con IVA"/>
                        </TextBlock>

                    </StackPanel>
                </Border>
                <!-- ══ FIN SECCIÓN PRECIOS ══ -->

                <!-- Stock Mínimo y Unidad de Medida -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stock Mínimo -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stock Mínimo" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                Padding="10,8"/>
                    </StackPanel>

                    <!-- Unidad de Medida -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unidad de Medida" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding UnidadMedida, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                Padding="10,8"
                                ToolTip="Ej: kg, unidad, litro"/>
                    </StackPanel>
                </Grid>

                <!-- Opciones -->
                <TextBlock Text="Opciones" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,10"/>

                <CheckBox Content="Controla vencimiento"
                         IsChecked="{Binding ControlaVencimiento}"
                         FontSize="14"
                         Margin="0,0,0,10"/>

                <!-- Días de alerta (solo si controla vencimiento) -->
                <StackPanel Margin="20,0,0,10"
                           Visibility="{Binding ControlaVencimiento, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Días de alerta antes del vencimiento" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding DiasAlertaVencimiento, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14"
                            Padding="10,8"
                            Width="100"
                            HorizontalAlignment="Left"/>
                </StackPanel>

                <CheckBox Content="Permite venta fraccionada (0.5 unidades)"
                         IsChecked="{Binding PermiteFraccionado}"
                         FontSize="14"
                         Margin="0,0,0,10"/>

                <!-- Mensaje de error -->
                <TextBlock Text="{Binding MensajeError}"
                          Foreground="Red"
                          FontSize="13"
                          Margin="0,15,0,0"
                          TextWrapping="Wrap"
                          Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer con botones -->
        <Border Grid.Row="2" 
               Background="White" 
               BorderBrush="#E0E0E0" 
               BorderThickness="0,1,0,0"
               Padding="30,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                           Width="120"
                           Height="40"
                           Margin="0,0,10,0"
                           FontSize="14"
                           Background="#E0E0E0"
                           Click="Cancelar_Click"/>

                    <Button Content="Guardar"
                           Width="120"
                           Height="40"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Background="#673AB7"
                           Foreground="White"
                           BorderThickness="0"
                           Command="{Binding GuardarCommand}"
                           IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Height="3"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>