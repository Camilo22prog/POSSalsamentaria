<UserControl x:Class="POS.UI.Views.Catalog.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:CategoriasViewModel}"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🏷️ Gestión de Categorías"
                      FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="↻ Actualizar"
                       Padding="15,10" Margin="0,0,10,0"
                       FontSize="13" Background="#2196F3" Foreground="White"
                       BorderThickness="0" Cursor="Hand"
                       Command="{Binding CargarCommand}"/>
                <Button Content="+ Nueva Categoría"
                       Padding="15,10" FontSize="14" FontWeight="SemiBold"
                       Background="#673AB7" Foreground="White"
                       BorderThickness="0" Cursor="Hand"
                       Command="{Binding NuevaCategoriaCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Contenido: lista + formulario lateral -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1"
                   CornerRadius="5" Margin="0,0,10,0">
                <Grid>
                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DataGrid ItemsSource="{Binding Categorias}"
                             SelectedItem="{Binding CategoriaSeleccionada}"
                             AutoGenerateColumns="False" IsReadOnly="True"
                             SelectionMode="Single" CanUserAddRows="False"
                             GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                             RowHeight="40" FontSize="13" Background="White" BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#673AB7"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTemplateColumn Header="Color" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Color}" CornerRadius="3"
                                               Width="50" Height="22" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Formulario lateral -->
            <Border Grid.Column="1"
                   BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5"
                   Background="#FAFAFA" Padding="20"
                   Visibility="{Binding MostrandoFormulario, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Nueva Categoría"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editando}" Value="True">
                                        <Setter Property="Text" Value="Editar Categoría"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Nombre *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NombreNueva, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14" Padding="10,8" Margin="0,0,0,15"/>

                    <TextBlock Text="Descripción" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding DescripcionNueva, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14" Padding="10,8" Height="60"
                            TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                    <TextBlock Text="Color (hex, ej: #673AB7)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ColorNueva, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14" Padding="10,8" Margin="0,0,0,15"/>

                    <TextBlock Text="{Binding MensajeError}" Foreground="Red" FontSize="12"
                              TextWrapping="Wrap" Margin="0,0,0,10"
                              Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Padding="15,8" Margin="0,0,10,0"
                               FontSize="13" Background="#E0E0E0" BorderThickness="0"
                               Cursor="Hand" Command="{Binding CancelarFormularioCommand}"/>
                        <Button Content="Guardar" Padding="15,8"
                               FontSize="13" FontWeight="SemiBold"
                               Background="#673AB7" Foreground="White"
                               BorderThickness="0" Cursor="Hand"
                               Command="{Binding GuardarCommand}"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Botones de acción (fila inferior) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                   HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="✏️ Editar seleccionada"
                   Padding="15,8" Margin="0,0,8,0"
                   FontSize="13" Background="#FF9800" Foreground="White"
                   BorderThickness="0" Cursor="Hand"
                   Command="{Binding EditarCategoriaCommand}"/>
            <Button Content="⛔ Desactivar"
                   Padding="15,8" Margin="0,0,8,0"
                   FontSize="13" Background="#F44336" Foreground="White"
                   BorderThickness="0" Cursor="Hand"
                   Command="{Binding DesactivarCommand}"/>
            <Button Content="✅ Activar"
                   Padding="15,8"
                   FontSize="13" Background="#4CAF50" Foreground="White"
                   BorderThickness="0" Cursor="Hand"
                   Command="{Binding ActivarCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
