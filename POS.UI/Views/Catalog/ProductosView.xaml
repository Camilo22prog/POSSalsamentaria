<UserControl x:Class="POS.UI.Views.Catalog.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductosViewModel}"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Gestión de Productos" 
                      FontSize="24" 
                      FontWeight="Bold"
                      VerticalAlignment="Center"/>

            <Button Content="+ Nuevo Producto"
                   HorizontalAlignment="Right"
                   Padding="20,10"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Background="#673AB7"
                   Foreground="White"
                   BorderThickness="0"
                   Cursor="Hand"
                   Command="{Binding NuevoProductoCommand}"/>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1"
               Background="#F5F5F5"
               Padding="15"
               CornerRadius="5"
               Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda -->
                <TextBox Grid.Column="0"
                        Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="13" Padding="10,8"
                        VerticalContentAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding BuscarCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Filtro por categoría -->
                <ComboBox Grid.Column="1"
                         ItemsSource="{Binding Categorias}"
                         SelectedValue="{Binding CategoriaFiltroId}"
                         DisplayMemberPath="Nombre"
                         SelectedValuePath="Id"
                         FontSize="13" Padding="10,8"
                         Margin="0,0,10,0"/>

                <!-- Filtro por proveedor -->
                <ComboBox Grid.Column="2"
                         ItemsSource="{Binding Proveedores}"
                         SelectedValue="{Binding ProveedorFiltroId}"
                         DisplayMemberPath="Nombre"
                         SelectedValuePath="Id"
                         FontSize="13" Padding="10,8"
                         Margin="0,0,10,0"/>

                <!-- Botón buscar -->
                <Button Grid.Column="3"
                       Content="🔍 Buscar"
                       Padding="15,8"
                       FontSize="13"
                       Background="#673AB7"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding BuscarCommand}"/>
            </Grid>
        </Border>

        <!-- Lista de productos -->
        <Border Grid.Row="2" 
               BorderBrush="#E0E0E0" 
               BorderThickness="1"
               CornerRadius="5">
            <Grid>
                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Height="4"
                            VerticalAlignment="Top"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Productos}"
                         SelectedItem="{Binding ProductoSeleccionado}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowHeight="40"
                         FontSize="13"
                         Background="White"
                         BorderThickness="0">

                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTextColumn Header="Código" 
                                          Binding="{Binding Codigo}" 
                                          Width="120"/>

                        <!-- Nombre -->
                        <DataGridTextColumn Header="Nombre" 
                                          Binding="{Binding Nombre}" 
                                          Width="*"/>

                        <!-- Categoría -->
                        <DataGridTemplateColumn Header="Categoría" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CategoriaColor}" 
                                           CornerRadius="3" 
                                           Padding="8,4"
                                           HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CategoriaNombre}" 
                                                  Foreground="White"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- IVA -->
                        <DataGridTextColumn Header="IVA" 
                                          Binding="{Binding TipoIVATexto}" 
                                          Width="100"/>

                        <!-- Precio Venta -->
                        <DataGridTextColumn Header="Precio Venta" 
                                          Binding="{Binding PrecioVenta, StringFormat=C}" 
                                          Width="120"/>

                        <!-- Stock -->
                        <DataGridTemplateColumn Header="Stock" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockActual}" 
                                              Foreground="{Binding TieneStockBajo, Converter={StaticResource StockColorConverter}}"
                                              FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tipo Unidad -->
                        <DataGridTextColumn Header="Unidad" 
                                          Binding="{Binding TipoUnidadTexto}" 
                                          Width="100"/>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="Acciones" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️" 
                                               ToolTip="Editar"
                                               Padding="8,4"
                                               Margin="2"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        
                                        <Button Content="🗑️" 
                                               ToolTip="Desactivar"
                                               Padding="8,4"
                                               Margin="2"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Command="{Binding DataContext.DesactivarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Mensaje cuando no hay productos -->
                <TextBlock Text="No se encontraron productos"
                          FontSize="16"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding Productos.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Mensaje de error -->
        <TextBlock Grid.Row="2"
                  Text="{Binding MensajeError}"
                  Foreground="Red"
                  FontSize="13"
                  Margin="0,10,0,0"
                  TextWrapping="Wrap"
                  VerticalAlignment="Bottom"
                  Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
    </Grid>
</UserControl>