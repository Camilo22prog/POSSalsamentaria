<UserControl x:Class="POS.UI.Views.Catalog.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProveedoresViewModel}"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🏭 Gestión de Proveedores"
                      FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="↻ Actualizar"
                       Padding="15,10" Margin="0,0,10,0"
                       FontSize="13" Background="#2196F3" Foreground="White"
                       BorderThickness="0" Cursor="Hand"
                       Command="{Binding CargarCommand}"/>
                <Button Content="+ Nuevo Proveedor"
                       Padding="15,10"
                       FontSize="14" FontWeight="SemiBold"
                       Background="#4CAF50" Foreground="White"
                       BorderThickness="0" Cursor="Hand"
                       Command="{Binding NuevoProveedorCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Lista + botones acción -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding Proveedores}"
                                 SelectedItem="{Binding ProveedorSeleccionado}"
                                 AutoGenerateColumns="False" IsReadOnly="True"
                                 SelectionMode="Single" CanUserAddRows="False"
                                 GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                 RowHeight="38" FontSize="13" Background="White" BorderThickness="0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Nombre Comercial" Binding="{Binding NombreComercial}" Width="150"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                                <DataGridTextColumn Header="Contacto" Binding="{Binding PersonaContacto}" Width="130"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal"
                           HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="✏️ Editar"
                           Padding="15,8" Margin="0,0,8,0"
                           FontSize="13" Background="#FF9800" Foreground="White"
                           BorderThickness="0" Cursor="Hand"
                           Command="{Binding EditarProveedorCommand}"/>
                    <Button Content="⛔ Desactivar"
                           Padding="15,8" Margin="0,0,8,0"
                           FontSize="13" Background="#F44336" Foreground="White"
                           BorderThickness="0" Cursor="Hand"
                           Command="{Binding DesactivarCommand}"/>
                    <Button Content="✅ Activar"
                           Padding="15,8"
                           FontSize="13" Background="#4CAF50" Foreground="White"
                           BorderThickness="0" Cursor="Hand"
                           Command="{Binding ActivarCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Formulario -->
            <Border Grid.Column="1"
                   BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5"
                   Background="#FAFAFA" Padding="20"
                   Visibility="{Binding MostrandoFormulario, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Nuevo Proveedor"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editando}" Value="True">
                                            <Setter Property="Text" Value="Editar Proveedor"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Nombre *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NombreForm, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Nombre Comercial" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NombreComercialForm, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TelefonoForm, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EmailForm, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Dirección" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding DireccionForm, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Persona de Contacto" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PersonaContactoForm, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding MensajeError}" Foreground="Red" FontSize="12"
                                  TextWrapping="Wrap" Margin="0,0,0,10"
                                  Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Padding="15,8" Margin="0,0,10,0"
                                   FontSize="13" Background="#E0E0E0" BorderThickness="0"
                                   Cursor="Hand" Command="{Binding CancelarFormularioCommand}"/>
                            <Button Content="Guardar" Padding="15,8"
                                   FontSize="13" FontWeight="SemiBold"
                                   Background="#4CAF50" Foreground="White"
                                   BorderThickness="0" Cursor="Hand"
                                   Command="{Binding GuardarCommand}"
                                   IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
