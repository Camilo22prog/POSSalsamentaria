<Window x:Class="POS.UI.Views.Purchases.NuevaCompraView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Purchases"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:NuevaCompraViewModel}"
        Title="Nueva Compra"
        Height="720" Width="1280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_PreviewMouseLeftButtonDown"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E65100">
            <TextBlock Text="🛒  Registrar Nueva Compra"
                       FontSize="18" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- Cuerpo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Encabezado de la compra -->
                <Border Background="White" CornerRadius="6" Padding="16" Margin="0,0,0,14"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Proveedor -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Proveedor *" FontSize="12" Foreground="#777" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Proveedores}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding ProveedorId}"
                                      DisplayMemberPath="Nombre"
                                      FontSize="13" Height="34"/>
                        </StackPanel>

                        <!-- N° Factura -->
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="N° Factura (opcional)" FontSize="12" Foreground="#777" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NumeroFactura, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Height="34" Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#BDBDBD" BorderThickness="1"/>
                        </StackPanel>

                        <!-- Fecha Compra -->
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Fecha de Compra" FontSize="12" Foreground="#777" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FechaCompra}" FontSize="13" Height="34"/>
                        </StackPanel>

                        <!-- Pagado -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,10,0,0">
                            <CheckBox Content="Pagada" IsChecked="{Binding Pagado}"
                                      FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Buscador de productos -->
                <Border Background="White" CornerRadius="6" Padding="16" Margin="0,0,0,14"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Agregar Producto" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E65100" Margin="0,0,0,10"/>

                        <!-- Barra de búsqueda -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TerminoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Height="34" Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#BDBDBD" BorderThickness="1"
                                     Margin="0,0,8,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding BuscarProductoCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="🔍 Buscar"
                                    Command="{Binding BuscarProductoCommand}"
                                    Padding="14,0" Height="34" FontSize="13"
                                    Background="#E65100" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Resultados búsqueda -->
                        <ListBox ItemsSource="{Binding ResultadosBusqueda}"
                                 SelectedItem="{Binding ProductoSeleccionado}"
                                 MaxHeight="120" Margin="0,0,0,10"
                                 Visibility="{Binding ResultadosBusqueda.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                 BorderBrush="#E0E0E0" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#E65100"/>
                                        <TextBlock Text="{Binding Nombre}"/>
                                        <TextBlock Text=" — " Foreground="#888"/>
                                        <TextBlock Text="{Binding PrecioCompra, StringFormat='Últ. compra: {0:C0}'}" Foreground="#888" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Panel de Liquidación Completo -->
                        <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10"
                                Visibility="{Binding ProductoSeleccionado, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Calculadora de Costos e Impuestos" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Fila 1: Básicos y Costo -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Cantidad" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding CantidadAgregar, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,10">
                                        <TextBlock Text="Precio Sin IVA" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding PrecioSinIvaAgregar, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,10">
                                        <TextBlock Text="% IVA" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding IvaPorcentajeAgregar, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,8,10">
                                        <TextBlock Text="Precio Con IVA" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding PrecioConIvaAgregar, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                                        <TextBlock Text="Total Línea" FontSize="11" FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding SubtotalAgregar, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="#E65100" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Fila 2: Otros Impuestos y Descuentos -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="% IBUA" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding IbuaPorcentajeAgregar, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                                        <TextBlock Text="% ICUI" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding IcuiPorcentajeAgregar, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,10">
                                        <TextBlock Text="% Descuento" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding DescuentoPorcentajeAgregar, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,8,10">
                                        <TextBlock Text="Val. Descuento" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding DescuentoValorAgregar, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                                        <TextBlock Text="Costo Liquidado" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding CostoUnitarioLiquidadoAgregar, StringFormat=C0}" FontSize="14" FontWeight="Bold" Foreground="#1565C0" Height="28" Padding="6,0" Background="#E3F2FD" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Fila 3: Vencimiento y Venta -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Lote" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LoteCodigoAgregar, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Vencimiento" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <DatePicker SelectedDate="{Binding FechaVencimientoAgregar}" Height="28" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="% Ganancia" FontSize="11" Foreground="#777" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding PorcentajeGananciaAgregar, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="Precio Venta Sug." FontSize="11" Foreground="#2E7D32" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding PrecioVentaCalculadoAgregar, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="13" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Row="2" Grid.Column="4" Content="+ Agregar"
                                            Command="{Binding AgregarItemCommand}"
                                            Padding="0,0" Height="28" FontSize="13" VerticalAlignment="Bottom"
                                            Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Error -->
                        <TextBlock Text="{Binding MensajeError}" Foreground="#C62828"
                                   FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding MensajeError.Length, Converter={StaticResource LessThanZeroConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Tabla de items -->
                <Border Background="White" CornerRadius="6" Margin="0,0,0,14"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="36" FontSize="13" Background="White" BorderThickness="0"
                              MinHeight="150">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#333"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="IVA %" Binding="{Binding IvaPorcentaje, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="Cost. s/IVA" Binding="{Binding PrecioSinIva, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Cost. c/IVA" Binding="{Binding PrecioConIva, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Desc. %" Binding="{Binding DescuentoPorcentaje, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="Desc. Val" Binding="{Binding DescuentoValor, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                            <DataGridTextColumn Header="ICUI %" Binding="{Binding IcuiPorcentaje, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="IBUA %" Binding="{Binding IbuaPorcentaje, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="Cost. Liq." Binding="{Binding CostoUnitarioLiquidado, StringFormat=N0}" Width="85" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Gan. %" Binding="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVentaCalculado, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Lote" Binding="{Binding LoteCodigo, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            
                            <DataGridTemplateColumn Header="Vencimiento" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding FechaVencimiento, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Height="25"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="Act. Cat." Binding="{Binding ActualizarCatalogo, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                            
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C0}" Width="90" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Command="{Binding DataContext.QuitarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="4,2" FontSize="11"
                                                Background="#FFEBEE" Foreground="#C62828"
                                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Total -->
        <Border Grid.Row="2" Background="#FFF3E0" Padding="20,10" BorderBrush="#FFE0B2" BorderThickness="0,1,0,1">
            <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#E65100">
                <Run Text="TOTAL: "/>
                <Run Text="{Binding TotalCompra, StringFormat=C0}"/>
            </TextBlock>
        </Border>

        <!-- Botones -->
        <Border Grid.Row="3" Background="White" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                        Padding="18,10" Margin="0,0,10,0" FontSize="13"
                        Background="#F5F5F5" Foreground="#555" BorderBrush="#BDBDBD" BorderThickness="1"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✅ Registrar Compra" Command="{Binding RegistrarCompraCommand}"
                        Padding="20,10" FontSize="14" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#E65100"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#BF360C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
