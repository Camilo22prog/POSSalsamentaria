<UserControl x:Class="POS.UI.Views.Expenses.GastosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Expenses"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:GastosViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Encabezado ────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🏢 Gastos Operativos" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Registre todos los gastos del negocio para completar el Estado de Resultados"
                           FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="↻ Actualizar"
                        Padding="15,9" Margin="0,0,10,0"
                        FontSize="13" Background="#2196F3" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding CargarCommand}"/>
                <Button Content="+ Nuevo Gasto"
                        Padding="15,9"
                        FontSize="14" FontWeight="SemiBold"
                        Background="#E65100" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding NuevoGastoCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ── Filtros ───────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#FFF3E0" CornerRadius="5" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}" Width="130" Margin="0,0,16,0"/>

                <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaFin, Mode=TwoWay}" Width="130" Margin="0,0,16,0"/>

                <Button Content="🔍 Filtrar" Padding="14,7"
                        Background="#E65100" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Command="{Binding CargarCommand}"/>

                <TextBlock Text="|" Foreground="#BDBDBD" Margin="12,0" VerticalAlignment="Center"/>

                <Button Content="Mes" Command="{Binding EstablecerRangoRapidoCommand}" CommandParameter="Mes"
                        Padding="10,5" Margin="0,0,5,0" FontSize="11" Background="#FFE0B2" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Mes Anterior" Command="{Binding EstablecerRangoRapidoCommand}" CommandParameter="MesAnterior"
                        Padding="10,5" Margin="0,0,5,0" FontSize="11" Background="#FFE0B2" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Trimestre" Command="{Binding EstablecerRangoRapidoCommand}" CommandParameter="Trimestre"
                        Padding="10,5" Margin="0,0,5,0" FontSize="11" Background="#FFE0B2" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Año" Command="{Binding EstablecerRangoRapidoCommand}" CommandParameter="Año"
                        Padding="10,5" FontSize="11" Background="#FFE0B2" BorderThickness="0" Cursor="Hand"/>

                <!-- Total del período -->
                <Border Background="#E65100" CornerRadius="4" Padding="14,6" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total período: " Foreground="White" FontSize="13"/>
                        <TextBlock Text="{Binding TotalPeriodo, StringFormat=C}"
                                   Foreground="White" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Contenido principal ───────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de gastos -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding Gastos}"
                                  SelectedItem="{Binding GastoSeleccionado}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  RowHeight="38" FontSize="13" Background="White" BorderThickness="0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E65100"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Categoría"
                                                    Binding="{Binding TipoNombre}"
                                                    Width="180"/>
                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding Descripcion}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Comprobante"
                                                    Binding="{Binding Comprobante}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Monto"
                                                    Binding="{Binding Monto, StringFormat=C}"
                                                    Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="✏️ Editar"
                            Padding="15,8" Margin="0,0,8,0"
                            FontSize="13" Background="#FF9800" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding EditarGastoCommand}"/>
                    <Button Content="🗑 Eliminar"
                            Padding="15,8"
                            FontSize="13" Background="#F44336" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding EliminarCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Formulario -->
            <Border Grid.Column="1"
                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5"
                    Background="#FAFAFA" Padding="20"
                    Visibility="{Binding MostrandoFormulario, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="➕ Nuevo Gasto"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editando}" Value="True">
                                            <Setter Property="Text" Value="✏️ Editar Gasto"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Categoría *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TiposGasto}"
                                  SelectedItem="{Binding TipoForm, Mode=TwoWay}"
                                  FontSize="14" Padding="10,8" Margin="0,0,0,12"
                                  Cursor="Hand"/>

                        <TextBlock Text="Descripción *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding DescripcionForm, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="10,8" Margin="0,0,0,12"
                                 AcceptsReturn="False"/>

                        <TextBlock Text="Monto *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MontoForm, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Fecha *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaForm, Mode=TwoWay}"
                                    FontSize="14" Margin="0,0,0,12"/>

                        <TextBlock Text="N° Comprobante / Factura" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ComprobanteForm, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock Text="Observaciones" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ObservacionesForm, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="10,8" Margin="0,0,0,16"
                                 TextWrapping="Wrap" Height="70" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="#C62828" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Padding="15,8" Margin="0,0,10,0"
                                    FontSize="13" Background="#E0E0E0" BorderThickness="0"
                                    Cursor="Hand" Command="{Binding CancelarFormularioCommand}"/>
                            <Button Content="💾 Guardar" Padding="15,8"
                                    FontSize="13" FontWeight="SemiBold"
                                    Background="#E65100" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Command="{Binding GuardarCommand}"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel vacío cuando no hay formulario -->
            <Border Grid.Column="1"
                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5"
                    Background="#FAFAFA">
                <Border.Visibility>
                    <Binding Path="MostrandoFormulario" Converter="{StaticResource InverseBooleanToVisibilityConverter}"/>
                </Border.Visibility>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                    <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Seleccione un gasto para editar"
                               FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock Text="o presione el botón Nuevo Gasto"
                               FontSize="13" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
