<Window x:Class="POS.UI.Views.UpdateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:UpdateViewModel}"
        Title="Actualizaciones del Sistema"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#673AB7" 
                CornerRadius="5" 
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🔄 ACTUALIZACIONES"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}"
                          FontSize="14"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"
                          Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <Border Grid.Row="1" 
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="5"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Versiones -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Versión Actual -->
                        <Border Grid.Column="0" 
                                Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="VERSIÓN ACTUAL"
                                          FontSize="12"
                                          Foreground="Gray"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding CurrentVersion}"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          Foreground="#673AB7"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Versión Disponible -->
                        <Border Grid.Column="2" 
                                Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="15">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="12"
                                          Foreground="Gray"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ÚLTIMA VERSIÓN"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                    <Setter Property="Text" Value="✨ NUEVA VERSIÓN"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="28"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding LatestVersion}"/>
                                            <Setter Property="Foreground" Value="#673AB7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="False">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Notas de actualización -->
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="15"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="📝 NOVEDADES"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="#673AB7"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding UpdateNotes}"
                                      TextWrapping="Wrap"
                                      FontSize="13"
                                      Foreground="#424242"/>
                        </StackPanel>
                    </Border>

                    <!-- Progreso de descarga -->
                    <Border Margin="0,20,0,0"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Descargando actualización..."
                                      FontSize="13"
                                      Foreground="Gray"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                            <ProgressBar Value="{Binding DownloadProgress}"
                                        Height="30"
                                        Minimum="0"
                                        Maximum="100"/>
                            <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0}%}"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="#673AB7"
                                      HorizontalAlignment="Center"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Verificar Actualizaciones"
                    Padding="0,12"
                    FontSize="14"
                    Background="#E0E0E0"
                    Foreground="#424242"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding CheckForUpdatesCommand}"
                    IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           CornerRadius="5"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2"
                    Padding="0,12"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#673AB7"/>
                        <Setter Property="Content" Value="Cerrar"/>
                        <Setter Property="Command" Value="{Binding CloseCommand}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           CornerRadius="5"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="Content" Value="⬇️ DESCARGAR E INSTALAR"/>
                                <Setter Property="Command" Value="{Binding DownloadAndInstallCommand}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>