<UserControl x:Class="POS.UI.Views.Settings.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ConfiguracionViewModel}"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="SeccionHeader" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Campo" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Encabezado ────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#37474F" Padding="20,16">
            <StackPanel>
                <TextBlock Text="⚙️ Configuración del Sistema"
                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Datos del negocio, impresora, balanza y actualizaciones"
                           FontSize="12" Foreground="#B0BEC5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Contenido con scroll ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda -->
                <StackPanel Grid.Column="0" Margin="30,24,15,24">

                    <!-- ── DATOS DEL NEGOCIO ──────────────────────────────── -->
                    <Border Style="{StaticResource SeccionHeader}" Background="#263238">
                        <TextBlock Text="🏪  DATOS DEL NEGOCIO" FontSize="13"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <StackPanel Style="{StaticResource Campo}">
                        <TextBlock Style="{StaticResource Label}" Text="Nombre del negocio *"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding NombreNegocio, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Aparece en el encabezado de cada ticket" FontSize="11"
                                   Foreground="Gray" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Campo}">
                        <TextBlock Style="{StaticResource Label}" Text="NIT / RUT"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Campo}">
                        <TextBlock Style="{StaticResource Label}" Text="Dirección"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Campo}">
                        <TextBlock Style="{StaticResource Label}" Text="Teléfono"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Campo}">
                        <TextBlock Style="{StaticResource Label}" Text="Mensaje pie de ticket"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding MensajePieTicket, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60"/>
                        <TextBlock Text="Máx. 60 caracteres — se imprime al final de cada ticket"
                                   FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- ── ACTUALIZACIONES ────────────────────────────────── -->
                    <Border Style="{StaticResource SeccionHeader}" Background="#263238" Margin="0,10,0,14">
                        <TextBlock Text="🔄  ACTUALIZACIONES" FontSize="13"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <StackPanel Style="{StaticResource Campo}">
                        <TextBlock Style="{StaticResource Label}" Text="URL del servidor de actualizaciones"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding UrlActualizaciones, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Ej: https://mi-servidor.com/updates  (dejar vacío para deshabilitar)"
                                   FontSize="11" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>

                <!-- Columna derecha -->
                <StackPanel Grid.Column="1" Margin="15,24,30,24">

                    <!-- ── IMPRESORA TÉRMICA ──────────────────────────────── -->
                    <Border Style="{StaticResource SeccionHeader}" Background="#263238">
                        <TextBlock Text="🖨️  IMPRESORA TÉRMICA" FontSize="13"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <StackPanel Style="{StaticResource Campo}">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Label}" Text="Impresora"/>
                            <Button Content="↻ Refrescar" HorizontalAlignment="Right"
                                    Padding="8,4" FontSize="11" Background="#546E7A"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding RefrescarDispositivosCommand}"/>
                        </Grid>
                        <ComboBox Style="{StaticResource Combo}"
                                  ItemsSource="{Binding ImpresorasDisponibles}"
                                  SelectedItem="{Binding ImpresoraSeleccionada, Mode=TwoWay}"/>
                        <TextBlock Text="Seleccione la impresora térmica de tickets. Auto-detectar busca por nombre (XP, 58, Thermal, POS)."
                                   FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Campo}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Label}"
                                       Text="Abrir cajón automáticamente al vender"
                                       VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding AbrirCajonAutomatico, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,0,4"/>
                        </DockPanel>
                        <TextBlock Text="Si está marcado, el cajón se abre en cada venta con pago en efectivo."
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- ── BALANZA SERIAL ─────────────────────────────────── -->
                    <Border Style="{StaticResource SeccionHeader}" Background="#263238" Margin="0,10,0,14">
                        <TextBlock Text="⚖️  BALANZA / BÁSCULA" FontSize="13"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <StackPanel Style="{StaticResource Campo}">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Label}" Text="Puerto COM"/>
                            <Button Content="↻ Refrescar" HorizontalAlignment="Right"
                                    Padding="8,4" FontSize="11" Background="#546E7A"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding RefrescarDispositivosCommand}"/>
                        </Grid>
                        <ComboBox Style="{StaticResource Combo}"
                                  ItemsSource="{Binding PuertosDisponibles}"
                                  SelectedItem="{Binding PuertoSeleccionado, Mode=TwoWay}"/>
                        <TextBlock Text="Auto-detectar prueba todos los puertos COM disponibles al iniciar."
                                   FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Campo}">
                        <TextBlock Style="{StaticResource Label}" Text="Velocidad (Baud Rate)"/>
                        <ComboBox Style="{StaticResource Combo}"
                                  ItemsSource="{Binding BaudRatesDisponibles}"
                                  SelectedItem="{Binding BaudRateSeleccionado, Mode=TwoWay}"/>
                        <TextBlock Text="La mayoría de balanzas usan 9600. Consulte el manual de su equipo."
                                   FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Nota de balanza -->
                    <Border Background="#E8F5E9" CornerRadius="4" Padding="12" Margin="0,4,0,0">
                        <TextBlock FontSize="11" Foreground="#2E7D32" TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="Nota: "/>
                            <Run Text="Los cambios de puerto y baud rate toman efecto la próxima vez que inicie la aplicación."/>
                        </TextBlock>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── Barra de acciones ─────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#ECEFF1" Padding="20,12" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <!-- Mensaje de estado -->
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#C62828"/>
                            <Setter Property="Text" Value="{Binding MensajeEstado}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GuardadoExitoso}" Value="True">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="↻ Recargar"
                            Padding="18,10" Margin="0,0,10,0"
                            FontSize="13" Background="#546E7A" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding CargarCommand}"/>
                    <Button Content="💾 Guardar Configuración"
                            Padding="22,10"
                            FontSize="14" FontWeight="SemiBold"
                            Background="#37474F" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding GuardarCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Cargando..." FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
