<Window x:Class="POS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="{Binding Titulo}" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" 
                Background="#673AB7"
                BorderBrush="#5E35B1"
                BorderThickness="0,0,0,2">
            <DockPanel Margin="20,0">

                <!-- Logo y Título -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🏪" 
                              FontSize="28" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="POS Salsamentaria" 
                              FontSize="20" 
                              FontWeight="Bold" 
                              VerticalAlignment="Center"
                              Foreground="White"/>
                </StackPanel>

                <!-- Usuario Info + Cerrar Sesión (Dock Right - va primero para quedar más a la derecha) -->
                <StackPanel Orientation="Horizontal" 
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center">
                    <TextBlock Text="👤" 
                              FontSize="20" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UsuarioActual.NombreCompleto}" 
                                  FontWeight="SemiBold"
                                  Foreground="White"
                                  FontSize="13"/>
                        <TextBlock Text="{Binding UsuarioActual.RolNombre}" 
                                  FontSize="11"
                                  Foreground="White"
                                  Opacity="0.8"/>
                    </StackPanel>

                    <!-- Botón Cerrar Sesión -->
                    <Button Content="🚪 Cerrar Sesión"
                           Margin="20,0,0,0"
                           Padding="15,8"
                           Background="#5E35B1"
                           Foreground="White"
                           BorderThickness="0"
                           FontWeight="SemiBold"
                           Cursor="Hand"
                           Command="{Binding CerrarSesionCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="5"
                                                   Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#512DA8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Botón de alertas de stock bajo -->
                <Button DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Padding="12,8"
                        Cursor="Hand"
                        Command="{Binding AbrirAlertasStockCommand}"
                        Visibility="{Binding HayAlertasStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F57F17"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E65100"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Stock Bajo" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" Foreground="White" FontWeight="Bold">
                                <Run Text="{Binding ContadorAlertasStock}"/>
                                <Run Text=" productos"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Versión + Botón Actualizaciones (Dock Right - va segundo para quedar a la izquierda del usuario) -->
                <StackPanel Orientation="Horizontal" 
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">

                    <TextBlock Text="{Binding VersionActual, StringFormat='v{0}'}"
                              FontSize="11"
                              Foreground="White"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"
                              Opacity="0.8"/>

                    <Button Content="🔄 Actualizaciones"
                            Padding="15,8"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding AbrirActualizacionesCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#512DA8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Side Menu (colapsable: 64px → 230px al pasar el mouse) -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Width="64"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True"
                    MouseEnter="Sidebar_MouseEnter"
                    MouseLeave="Sidebar_MouseLeave">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,10">

                        <!-- Dashboard -->
                        <Button ToolTip="Dashboard"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Ventas -->
                        <Button ToolTip="Ventas"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarPOSCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Ventas" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Historial Ventas -->
                        <Button ToolTip="Historial Ventas"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="HistorialVentas">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Historial Ventas" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Productos -->
                        <Button ToolTip="Productos"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Productos"
                                Visibility="{Binding PuedeGestionarProductos, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Productos" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Inventario -->
                        <Button ToolTip="Inventario"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Inventario"
                                Visibility="{Binding PuedeGestionarInventario, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗄️" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Inventario" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Clientes -->
                        <Button ToolTip="Clientes"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Clientes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Clientes" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Reportes -->
                        <Button ToolTip="Reportes"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Reportes"
                                Visibility="{Binding PuedeVerReportes, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Reportes" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Usuarios -->
                        <Button ToolTip="Usuarios"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding AbrirUsuariosCommand}"
                                Visibility="{Binding PuedeGestionarUsuarios, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Usuarios" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="8,10"
                                   Visibility="{Binding UsuarioActual.PuedeGestionarUsuarios, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Categorías -->
                        <Button ToolTip="Categorías"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Categorias"
                                Visibility="{Binding PuedeGestionarProductos, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Categorías" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Proveedores -->
                        <Button ToolTip="Proveedores"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Proveedores"
                                Visibility="{Binding PuedeGestionarProductos, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏭" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Proveedores" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Compras -->
                        <Button ToolTip="Compras"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Compras"
                                Visibility="{Binding PuedeGestionarProductos, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Compras" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Gastos Operativos -->
                        <Button ToolTip="Gastos Operativos"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Gastos"
                                Visibility="{Binding PuedeGestionarProductos, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💸" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Gastos Operativos" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Configuración -->
                        <Button ToolTip="Configuración"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0" Height="46" Margin="4,1"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Configuracion"
                                Visibility="{Binding UsuarioActual.PuedeGestionarUsuarios, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="20" Width="56"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Configuración" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Column="1">
                <!-- Contenido dinámico -->
                <ContentControl Content="{Binding ContenidoActual}"/>

            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
               Background="#EDE7F6"
               BorderBrush="#9575CD"
               BorderThickness="0,1,0,0"
               Padding="15,5">
            <DockPanel>
                <TextBlock Text="{Binding HoraStatusBar}"
                          DockPanel.Dock="Right"
                          VerticalAlignment="Center"
                          FontSize="11"
                          FontWeight="SemiBold"
                          Foreground="#512DA8"
                          FontFamily="Consolas"/>
                <TextBlock Text="Sistema POS v1.0 | Desarrollado con ❤️"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Foreground="#512DA8"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>