<UserControl x:Class="POS.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:POS.UI.Helpers"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F0F2F5"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilo base para accesos rápidos -->
        <Style x:Key="AccesoRapidoBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="20,18">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" Opacity="0.07" BlurRadius="12" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCEEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de stat card -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 HEADER — Saludo, hora y fecha
            ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1A3E" Offset="0"/>
                        <GradientStop Color="#16213E" Offset="0.5"/>
                        <GradientStop Color="#0F3460" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="36,30,36,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Saludo y usuario -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" Foreground="#B0BEC5" Margin="0,0,0,6">
                            <Run Text="{Binding SaludoHora, Mode=OneWay}"/>
                            <Run Text=","/>
                        </TextBlock>
                        <TextBlock Text="{Binding NombreUsuario}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,10"/>
                        <Border Background="#FFFFFF20" CornerRadius="20"
                                Padding="12,5" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding RolUsuario}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#90CAF9"/>
                        </Border>
                    </StackPanel>

                    <!-- Reloj y fecha -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HoraActual}"
                                   FontSize="44" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Right"
                                   FontFamily="Consolas"/>
                        <TextBlock Text="{Binding FechaActual}"
                                   FontSize="13" Foreground="#B0BEC5"
                                   HorizontalAlignment="Right" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 ACCESOS RÁPIDOS  (visibles según rol)
            ════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="30,26,30,0">

                <TextBlock Text="Acceso rápido"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#37474F" Margin="4,0,0,14"/>

                <!--
                  Orden: siempre-visibles primero → gated por permiso después.
                  Cajero    → 4 botones (fila 1 completa)
                  Supervisor → 5 botones (fila 1 + Reportes)
                  Admin     → 8 botones (2 filas completas)
                -->
                <WrapPanel>

                    <!-- ── Siempre visibles ───────────────────────────────────── -->

                    <!-- Nueva Venta -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Command="{Binding DataContext.NavegarPOSCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#E8F5E9" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="🛒" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nueva Venta" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Punto de venta" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Dashboard -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Command="{Binding DataContext.NavegarDashboardCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#E3F2FD" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="📊" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Dashboard" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Estadísticas del día" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Historial de Ventas -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Command="{Binding DataContext.NavegarCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="HistorialVentas">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#FBE9E7" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="📋" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Historial de Ventas" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Consultar transacciones" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Clientes -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Command="{Binding DataContext.NavegarClientesCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#E0F2F1" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="👥" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Clientes" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Gestión de clientes" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- ── Requieren PuedeVerReportes (Supervisor + Admin) ──────── -->

                    <!-- Reportes -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Visibility="{Binding DataContext.PuedeVerReportes,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.NavegarCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Reportes">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#E8EAF6" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="📑" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Reportes" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Informes y exportación" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- ── Requieren PuedeGestionarProductos (Admin únicamente) ── -->

                    <!-- Productos -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Visibility="{Binding DataContext.PuedeGestionarProductos,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.NavegarProductosCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#FFF8E1" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Productos" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Catálogo de artículos" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Inventario -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Visibility="{Binding DataContext.PuedeGestionarInventario,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.NavegarInventarioCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#F3E5F5" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="🔢" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Inventario" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Stock y movimientos" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- ── Requiere PuedeGestionarUsuarios (Admin únicamente) ──── -->

                    <!-- Configuración -->
                    <Button Width="230" Style="{StaticResource AccesoRapidoBtn}" Margin="0,0,10,10"
                            Visibility="{Binding DataContext.PuedeGestionarUsuarios,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.NavegarCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Configuracion">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#ECEFF1" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="⚙️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Configuración" FontSize="13" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ajustes del sistema" FontSize="11"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════
                 ESTADÍSTICAS RÁPIDAS DEL DÍA
            ════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="2" Margin="30,24,30,0">
                <TextBlock Text="Resumen de hoy"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#37474F" Margin="4,0,0,14"/>

                <!-- Skeleton loader cuando no han cargado -->
                <Grid Visibility="{Binding StatsLoaded, Converter={StaticResource BoolToVis}}">
                    <UniformGrid Rows="1" Columns="4">

                        <!-- Ventas del día -->
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                            <Border.Effect><DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="💰 Ventas hoy"
                                               FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding VentasHoy, StringFormat=C}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="#27AE60" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44"
                                        Background="#E8F5E9" CornerRadius="22"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="💰" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Transacciones -->
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                            <Border.Effect><DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🛒 Transacciones"
                                               FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TransaccionesHoy}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="#3498DB" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44"
                                        Background="#E3F2FD" CornerRadius="22"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Estado caja -->
                        <Border Margin="0,0,10,0" CornerRadius="10" Padding="20,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                            <Setter Property="Background" Value="#F1FFF5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect><DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="💼 Caja" FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="CERRADA"/>
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                                        <Setter Property="Text" Value="ABIERTA"/>
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="💼" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Alertas de stock -->
                        <Border CornerRadius="10" Padding="20,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProductosStockBajo}" Value="0">
                                            <Setter Property="Background" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect><DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⚠️ Stock bajo" FontSize="12" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProductosStockBajo}"
                                               FontSize="24" FontWeight="Bold"
                                               Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProductosStockBajo}" Value="0">
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="productos con alerta" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44"
                                        Background="#FFF8E1" CornerRadius="22"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="⚠️" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                    </UniformGrid>
                </Grid>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════
                 ATAJOS Y TIPS
            ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="30,20,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Atajos de teclado -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <Border.Effect><DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⌨️ Atajos útiles" FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 0 -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#EDE7F6" CornerRadius="5"
                                    Padding="8,4" Margin="0,0,12,8">
                                <TextBlock Text="F2" FontSize="12" FontWeight="Bold"
                                           Foreground="#673AB7" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Buscar producto rápido"
                                       FontSize="13" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Fila 1 -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#E3F2FD" CornerRadius="5"
                                    Padding="8,4" Margin="0,0,12,8">
                                <TextBlock Text="Enter" FontSize="12" FontWeight="Bold"
                                           Foreground="#1565C0" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Confirmar acción"
                                       FontSize="13" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Fila 2 -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#E8F5E9" CornerRadius="5"
                                    Padding="8,4" Margin="0,0,12,8">
                                <TextBlock Text="Esc" FontSize="12" FontWeight="Bold"
                                           Foreground="#2E7D32" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Cancelar / cerrar diálogo"
                                       FontSize="13" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Fila 3 -->
                            <Border Grid.Row="3" Grid.Column="0" Background="#FFF3E0" CornerRadius="5"
                                    Padding="8,4" Margin="0,0,12,8">
                                <TextBlock Text="Tab" FontSize="12" FontWeight="Bold"
                                           Foreground="#E65100" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Moverse entre campos"
                                       FontSize="13" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Fila 4 -->
                            <Border Grid.Row="4" Grid.Column="0" Background="#FCE4EC" CornerRadius="5"
                                    Padding="8,4" Margin="0,0,12,0">
                                <TextBlock Text="Alt+F4" FontSize="12" FontWeight="Bold"
                                           Foreground="#AD1457" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Cerrar la aplicación"
                                       FontSize="13" Foreground="#546E7A" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Consejos del sistema -->
                <Border Grid.Column="1" CornerRadius="10" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E8EAF6" Offset="0"/>
                            <GradientStop Color="#EDE7F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect><DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💡 Consejos de uso" FontSize="14" FontWeight="Bold"
                                   Foreground="#311B92" Margin="0,0,0,14"/>

                        <Border Background="#FFFFFFAA" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="20">
                                <Run FontWeight="Bold" Text="Dashboard de ventas:"/>
                                <Run Text=" cambia el período (Hoy / Semana / Mes / Año) para ver la tendencia de ventas en distintos intervalos."/>
                            </TextBlock>
                        </Border>

                        <Border Background="#FFFFFFAA" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="20">
                                <Run FontWeight="Bold" Text="Alertas de stock:"/>
                                <Run Text=" revisa el Dashboard de Inventario para ver los productos que necesitan reabastecerse."/>
                            </TextBlock>
                        </Border>

                        <Border Background="#FFFFFFAA" CornerRadius="8" Padding="12">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="20">
                                <Run FontWeight="Bold" Text="Cierre de caja:"/>
                                <Run Text=" recuerda cerrar la caja al final del día desde el módulo de Ventas para registrar el arqueo."/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
