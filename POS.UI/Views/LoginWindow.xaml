<Window x:Class="POS.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
        Title="POS Salsamentaria - Login"
        Height="500"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown">

    <Border CornerRadius="15" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" 
                            ShadowDepth="0" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    CornerRadius="15,15,0,0">
                <StackPanel VerticalAlignment="Center" 
                           HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Store" 
                                           Width="60" 
                                           Height="60" 
                                           Foreground="White"/>
                    <TextBlock Text="POS Salsamentaria" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="White"
                              HorizontalAlignment="Center"
                              Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" 
                       Margin="40,30,40,40"
                       VerticalAlignment="Center">

                <TextBlock Text="Iniciar Sesión" 
                          FontSize="20" 
                          FontWeight="SemiBold"
                          Margin="0,0,0,30"
                          HorizontalAlignment="Center"/>

                <!-- Usuario -->
                <TextBox materialDesign:HintAssist.Hint="Usuario"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,20"
                        FontSize="14"
                        Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <PasswordBox materialDesign:HintAssist.Hint="Contraseña"
                            Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                            Margin="0,0,0,10"
                            FontSize="14"
                            x:Name="PasswordBox"
                            PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Mensaje de error -->
                <TextBlock Text="{Binding MensajeError}" 
                          Foreground="Red" 
                          FontSize="12"
                          Margin="0,10,0,20"
                          TextWrapping="Wrap"
                          Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Botón Login -->
                <Button Content="INGRESAR"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Height="45"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Command="{Binding LoginCommand}"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Margin="0,15,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Botón Cancelar -->
                <Button Content="Cancelar"
                       Style="{StaticResource MaterialDesignFlatButton}"
                       Margin="0,15,0,0"
                       Command="{Binding CancelarCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>