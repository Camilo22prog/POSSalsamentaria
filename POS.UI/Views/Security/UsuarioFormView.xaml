<Window x:Class="POS.UI.Views.Security.UsuarioFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Security"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:UsuarioFormViewModel}"
        Title="{Binding Titulo}"
        Height="650"
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#673AB7">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="👤" FontSize="28" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Titulo}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,20">
            <StackPanel>
                <!-- Nombre de Usuario -->
                <TextBlock Text="Nombre de Usuario *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Margin="0,0,0,15"
                        BorderBrush="#BDBDBD"
                        BorderThickness="1"
                        IsEnabled="{Binding EsEdicion, Converter={StaticResource InverseBooleanConverter}}"/>

                <!-- Nombre Completo -->
                <TextBlock Text="Nombre Completo *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Margin="0,0,0,15"
                        BorderBrush="#BDBDBD"
                        BorderThickness="1"/>

                <!-- Email -->
                <TextBlock Text="Email *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Margin="0,0,0,15"
                        BorderBrush="#BDBDBD"
                        BorderThickness="1"/>

                <!-- Teléfono -->
                <TextBlock Text="Teléfono" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Margin="0,0,0,15"
                        BorderBrush="#BDBDBD"
                        BorderThickness="1"/>

                <!-- Rol -->
                <TextBlock Text="Rol *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Roles}"
                         SelectedValue="{Binding RolSeleccionado}"
                         SelectedValuePath="Rol"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,15"
                         BorderBrush="#BDBDBD"
                         BorderThickness="1">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Descripcion}" 
                                          FontSize="11" 
                                          Foreground="Gray"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Separador -->
                <Border Height="1" Background="#E0E0E0" Margin="0,10,0,20"/>

                <!-- Contraseña (solo si es nuevo o si quiere cambiarla) -->
                <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Contraseña *"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsEdicion}" Value="True">
                                    <Setter Property="Text" Value="Nueva Contraseña (dejar en blanco para mantener la actual)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <PasswordBox x:Name="txtPassword"
                            FontSize="14"
                            Padding="10,8"
                            Margin="0,0,0,15"
                            BorderBrush="#BDBDBD"
                            BorderThickness="1"
                            PasswordChanged="TxtPassword_PasswordChanged"/>

                <!-- Confirmar Contraseña -->
                <TextBlock Text="Confirmar Contraseña" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtConfirmarPassword"
                            FontSize="14"
                            Padding="10,8"
                            Margin="0,0,0,15"
                            BorderBrush="#BDBDBD"
                            BorderThickness="1"
                            PasswordChanged="TxtConfirmarPassword_PasswordChanged"/>

                <!-- Nota -->
                <Border Background="#FFF3E0" 
                       BorderBrush="#FFB74D" 
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="15"
                       Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Información importante:" 
                                  FontWeight="Bold" 
                                  FontSize="13"
                                  Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#666">
                            <Run Text="• Los campos marcados con * son obligatorios"/>
                            <LineBreak/>
                            <Run Text="• El nombre de usuario no se puede cambiar después de crear el usuario"/>
                            <LineBreak/>
                            <Run Text="• La contraseña debe tener al menos 4 caracteres"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                       Content="💾 Guardar"
                       Padding="30,12"
                       Margin="0,0,10,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding GuardarCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2"
                       Content="Cancelar"
                       Padding="30,12"
                       FontSize="14"
                       Background="#E0E0E0"
                       Foreground="#424242"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding CancelarCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>