<Window x:Class="POS.UI.Views.Inventory.KardexView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Inventory"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:KardexViewModel}"
        Title="Kardex de Producto" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1976D2">
            <TextBlock Text="📊 Kardex - Historial de Movimientos" 
                      FontSize="22" 
                      FontWeight="Bold" 
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="30,0"/>
        </Border>

        <!-- Filtros de fecha -->
        <Border Grid.Row="1" 
               Background="White" 
               Padding="20"
               BorderBrush="#E0E0E0"
               BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="Desde:" 
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Margin="0,0,10,0"/>

                <DatePicker Grid.Column="1" 
                           SelectedDate="{Binding FechaDesde}"
                           FontSize="13"/>

                <TextBlock Grid.Column="3" 
                          Text="Hasta:" 
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Margin="0,0,10,0"/>

                <DatePicker Grid.Column="4" 
                           SelectedDate="{Binding FechaHasta}"
                           FontSize="13"/>

                <Button Grid.Column="6"
                       Content="🔍 Filtrar"
                       Padding="20,8"
                       FontSize="13"
                       Background="#1976D2"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding CargarMovimientosCommand}"/>
            </Grid>
        </Border>

        <!-- Lista de movimientos -->
        <Border Grid.Row="2" 
               Background="White"
               Margin="20">
            <Grid>
                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Height="4"
                            VerticalAlignment="Top"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Movimientos}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowHeight="35"
                         FontSize="12"
                         Background="White"
                         BorderThickness="0">

                    <DataGrid.Columns>
                        <!-- Fecha -->
                        <DataGridTextColumn Header="Fecha" 
                                          Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" 
                                          Width="130"/>

                        <!-- Tipo -->
                        <DataGridTemplateColumn Header="Tipo" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Tipo, Converter={StaticResource TipoMovimientoColorConverter}}" 
                                           CornerRadius="3" 
                                           Padding="6,3"
                                           HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TipoTexto}" 
                                                  Foreground="White"
                                                  FontSize="10"
                                                  FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cantidad -->
                        <DataGridTextColumn Header="Cantidad" 
                                          Binding="{Binding Cantidad, StringFormat=N2}" 
                                          Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Stock Anterior -->
                        <DataGridTextColumn Header="Stock Ant." 
                                          Binding="{Binding StockAnterior, StringFormat=N2}" 
                                          Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Stock Nuevo -->
                        <DataGridTextColumn Header="Stock Nuevo" 
                                          Binding="{Binding StockNuevo, StringFormat=N2}" 
                                          Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Costo Unitario -->
                        <DataGridTextColumn Header="Costo Unit." 
                                          Binding="{Binding CostoUnitario, StringFormat=C}" 
                                          Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Costo Total -->
                        <DataGridTextColumn Header="Costo Total" 
                                          Binding="{Binding CostoTotal, StringFormat=C}" 
                                          Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Motivo -->
                        <DataGridTextColumn Header="Motivo" 
                                          Binding="{Binding Motivo}" 
                                          Width="*"/>

                        <!-- Usuario -->
                        <DataGridTextColumn Header="Usuario" 
                                          Binding="{Binding UsuarioNombre}" 
                                          Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Mensaje cuando no hay movimientos -->
                <TextBlock Text="No hay movimientos en el período seleccionado"
                          FontSize="16"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding Movimientos.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>