<UserControl x:Class="POS.UI.Views.Inventory.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Inventory"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:InventarioViewModel}"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📋 Inventario Actual" 
                      FontSize="24" 
                      FontWeight="Bold"
                      VerticalAlignment="Center"/>

            <Button Content="🔄 Actualizar"
                   HorizontalAlignment="Right"
                   Padding="15,8"
                   FontSize="13"
                   Background="#673AB7"
                   Foreground="White"
                   BorderThickness="0"
                   Cursor="Hand"
                   Command="{Binding CargarInventarioCommand}"/>
        </Grid>

        <!-- Estadísticas -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Valor Total -->
            <Border Grid.Column="0" 
                   Background="#E8F5E9" 
                   CornerRadius="8"
                   Padding="20"
                   Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="💰 Valor Total Inventario" 
                              FontSize="12" 
                              Foreground="Gray"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ValorTotalInventario, StringFormat=C}" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Foreground="#2E7D32"/>
                </StackPanel>
            </Border>

            <!-- Productos con Stock -->
            <Border Grid.Column="1" 
                   Background="#E3F2FD" 
                   CornerRadius="8"
                   Padding="20"
                   Margin="5,0">
                <StackPanel>
                    <TextBlock Text="📦 Productos con Stock" 
                              FontSize="12" 
                              Foreground="Gray"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ProductosConStock}" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Foreground="#1976D2"/>
                </StackPanel>
            </Border>

            <!-- Stock Bajo -->
            <Border Grid.Column="2" 
                   Background="#FFEBEE" 
                   CornerRadius="8"
                   Padding="20"
                   Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="⚠️ Stock Bajo" 
                              FontSize="12" 
                              Foreground="Gray"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ProductosStockBajo}" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Foreground="#C62828"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="2" 
               Background="#F5F5F5" 
               Padding="15"
               CornerRadius="5"
               Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda -->
                <TextBox Grid.Column="0"
                        Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="13"
                        Padding="10,8"
                        Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding BuscarCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Checkbox Solo Stock Bajo -->
                <CheckBox Grid.Column="1"
                         Content="Solo stock bajo"
                         IsChecked="{Binding SoloStockBajo}"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"
                         FontSize="13"/>

                <!-- Botón buscar -->
                <Button Grid.Column="2"
                       Content="🔍 Buscar"
                       Padding="15,8"
                       FontSize="13"
                       Background="#673AB7"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding BuscarCommand}"/>
            </Grid>
        </Border>

        <!-- Lista de inventario -->
        <Border Grid.Row="3" 
               BorderBrush="#E0E0E0" 
               BorderThickness="1"
               CornerRadius="5">
            <Grid>
                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Height="4"
                            VerticalAlignment="Top"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Inventario}"
                         SelectedItem="{Binding ProductoSeleccionado}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowHeight="40"
                         FontSize="13"
                         Background="White"
                         BorderThickness="0">

                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTextColumn Header="Código" 
                                          Binding="{Binding Codigo}" 
                                          Width="100"/>

                        <!-- Nombre -->
                        <DataGridTextColumn Header="Producto" 
                                          Binding="{Binding Nombre}" 
                                          Width="*"/>

                        <!-- Categoría -->
                        <DataGridTemplateColumn Header="Categoría" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CategoriaColor}" 
                                           CornerRadius="3" 
                                           Padding="8,4"
                                           HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CategoriaNombre}" 
                                                  Foreground="White"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock Actual -->
                        <DataGridTemplateColumn Header="Stock Actual" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockActual, StringFormat=N2}" 
                                              Foreground="{Binding TieneStockBajo, Converter={StaticResource StockColorConverter}}"
                                              FontWeight="Bold"
                                              HorizontalAlignment="Right"
                                              Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock Mínimo -->
                        <DataGridTextColumn Header="Stock Mín." 
                                          Binding="{Binding StockMinimo, StringFormat=N2}" 
                                          Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Unidad -->
                        <DataGridTextColumn Header="Unidad" 
                                          Binding="{Binding UnidadMedida}" 
                                          Width="80"/>

                        <!-- Costo Promedio -->
                        <DataGridTextColumn Header="Costo Prom." 
                                          Binding="{Binding CostoPromedio, StringFormat=C}" 
                                          Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Valor Total -->
                        <DataGridTextColumn Header="Valor Total" 
                                          Binding="{Binding ValorInventario, StringFormat=C}" 
                                          Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="Acciones" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="📝 Ajustar" 
                                               ToolTip="Ajustar Stock"
                                               Padding="8,4"
                                               Margin="2"
                                               FontSize="11"
                                               Background="#673AB7"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Command="{Binding DataContext.AjustarStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        
                                        <Button Content="📊 Kardex" 
                                               ToolTip="Ver Kardex"
                                               Padding="8,4"
                                               Margin="2"
                                               FontSize="11"
                                               Background="#1976D2"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Command="{Binding DataContext.VerKardexCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Mensaje cuando no hay productos -->
                <TextBlock Text="No se encontraron productos en inventario"
                          FontSize="16"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding Inventario.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>