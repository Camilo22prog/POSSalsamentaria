<Window x:Class="POS.UI.Views.Inventory.AjustarStockView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Inventory"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AjustarStockViewModel}"
        Title="Ajustar Stock" 
        Height="730" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="📝 Ajustar Stock y Precios" 
                      FontSize="22" 
                      FontWeight="Bold" 
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="30,0"/>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">

                <!-- Producto -->
                <TextBlock Text="Producto" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#37474F"/>
                <TextBox Text="{Binding ProductoNombre}"
                        FontSize="14"
                        Padding="10,8"
                        IsReadOnly="True"
                        Background="#ECEFF1"
                        BorderBrush="#CFD8DC"
                        Margin="0,0,0,15"
                        IsTabStop="False"/>

                <!-- Stock Actual y Nuevo -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stock Actual" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#37474F"/>
                        <TextBox Text="{Binding StockActual, StringFormat=N2}"
                                FontSize="14"
                                Padding="10,8"
                                IsReadOnly="True"
                                Background="#ECEFF1"
                                BorderBrush="#CFD8DC"
                                IsTabStop="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stock Nuevo *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#37474F"/>
                        <TextBox Text="{Binding CantidadNueva, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                FontSize="14"
                                Padding="10,8"
                                BorderBrush="#2C3E50"
                                BorderThickness="1.5"
                                TabIndex="1"
                                x:Name="TxtStockNuevo"/>
                    </StackPanel>
                </Grid>

                <!-- Tipo de Movimiento -->
                <TextBlock Text="Tipo de Movimiento *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#37474F"/>
                <ComboBox ItemsSource="{Binding TiposMovimiento}"
                         SelectedValue="{Binding TipoMovimiento}"
                         DisplayMemberPath="Texto"
                         SelectedValuePath="Valor"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="#CFD8DC"
                         Margin="0,0,0,15"
                         TabIndex="2"/>

                <!-- Motivo -->
                <TextBlock Text="Motivo * (explique el motivo del ajuste)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#37474F"/>
                <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10"
                        Height="80"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        VerticalContentAlignment="Top"
                        BorderBrush="#2C3E50"
                        BorderThickness="1.5"
                        Background="White"
                        Margin="0,0,0,15"
                        TabIndex="3"
                        x:Name="TxtMotivo"/>

                <!-- Costo Unitario -->
                <TextBlock Text="Costo Unitario (opcional - para valorizar inventario)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#37474F"/>
                <TextBox Text="{Binding CostoUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                        FontSize="14"
                        Padding="10,8"
                        BorderBrush="#CFD8DC"
                        Margin="0,0,0,15"
                        TabIndex="4"/>

                <!-- ══ SECCIÓN PRECIOS Y MÁRGENES ══ -->
                <Border Background="#F8F9FA"
                        BorderBrush="#CFD8DC"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>

                        <TextBlock Text="💰 PRECIOS Y MÁRGENES"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,14"/>

                        <!-- Fila 1: Precio Compra sin IVA | Precio Compra con IVA -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio Compra (sin IVA)"
                                           FontSize="11"
                                           Foreground="#546E7A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PrecioCompra, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         FontSize="14"
                                         Padding="10,8"
                                         TabIndex="5"
                                         ToolTip="Base de costo antes de impuesto. Los demás campos se calculan desde aquí."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio Compra (con IVA)"
                                           FontSize="11"
                                           Foreground="#546E7A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PrecioCompraConIVA, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         FontSize="14"
                                         Padding="10,8"
                                         TabIndex="6"
                                         ToolTip="Si ingresa este valor, el precio sin IVA se recalcula automáticamente."/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila 2: Margen (%) | Precio de Venta Sugerido (solo lectura) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Margen de Ganancia (%)"
                                           FontSize="11"
                                           Foreground="#546E7A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding MargenGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         FontSize="14"
                                         Padding="10,8"
                                         TabIndex="7"
                                         ToolTip="Modifique para recalcular el precio sugerido. Se actualiza automáticamente al cambiar el precio final."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio de Venta Sugerido"
                                           FontSize="11"
                                           Foreground="#2E7D32"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <!-- Solo lectura: borde verde, no es TextBox editable -->
                                <Border Background="#E8F5E9"
                                        BorderBrush="#A5D6A7"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,9">
                                    <Grid>
                                        <TextBlock Text="{Binding PrecioVentaSugerido, StringFormat=C}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#2E7D32"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="calculado automáticamente"
                                                   FontSize="10"
                                                   Foreground="#66BB6A"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Separador -->
                        <Separator Margin="0,0,0,12" Background="#CFD8DC"/>

                        <!-- Fila 3: Precio de Venta Final (ancho completo, destacado) -->
                        <TextBlock Text="Precio de Venta Final *"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Padding="10,10"
                                 BorderBrush="#2E7D32"
                                 BorderThickness="2"
                                 TabIndex="8"
                                 ToolTip="Precio final al cliente. Al modificarlo se recalcula el margen de ganancia real."/>

                        <!-- Indicador de margen real -->
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="#37474F">
                            <Run Text="Margen real: "/>
                            <Run Text="{Binding MargenGanancia, StringFormat='{}{0:N1}%'}"
                                 FontWeight="Bold"
                                 Foreground="#2E7D32"/>
                            <Run Text=" sobre precio de compra con IVA"/>
                        </TextBlock>

                    </StackPanel>
                </Border>

                <!-- Mensaje de error -->
                <Border Background="#FFEBEE" 
                       BorderBrush="#EF5350" 
                       BorderThickness="1"
                       CornerRadius="3"
                       Padding="10"
                       Margin="0,5,0,0"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding MensajeError}"
                              Foreground="#C62828"
                              FontSize="13"
                              TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer con botones -->
        <Border Grid.Row="2" 
               Background="#F8F9FA" 
               BorderBrush="#CFD8DC" 
               BorderThickness="0,1,0,0"
               Padding="30,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancelar"
                           Width="120"
                           Height="40"
                           Margin="0,0,10,0"
                           FontSize="14"
                           Background="#ECEFF1"
                           Foreground="#546E7A"
                           BorderThickness="0"
                           Cursor="Hand"
                           Click="Cancelar_Click"
                           TabIndex="10">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CFD8DC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Guardar"
                           Width="120"
                           Height="40"
                           FontSize="14"
                           FontWeight="Bold"
                           Background="#2E7D32"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"
                           Command="{Binding GuardarCommand}"
                           IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                           TabIndex="9">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1B5E20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Height="3"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>