<UserControl x:Class="POS.UI.Views.Reports.ReporteInventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ReporteInventarioViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#FF5722" 
                Padding="20">
            <TextBlock>
                <Run Text="📦" FontSize="24"/>
                <Run Text=" REPORTE DE INVENTARIO" 
                     FontSize="20" 
                     FontWeight="Bold"
                     Foreground="White"/>
            </TextBlock>
        </Border>

        <!-- Botones de acción -->
        <Border Grid.Row="1" 
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <StackPanel Orientation="Horizontal">
                <Button Content="🔍 Generar Reporte"
                       Padding="20,10"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding GenerarReporteCommand}"/>

                <Button Content="📥 Exportar Excel"
                       Padding="20,10"
                       Margin="10,0,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#FF9800"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding ExportarExcelCommand}"/>
            </StackPanel>
        </Border>

        <!-- Resumen Ejecutivo -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Productos -->
                <Border Grid.Column="0" 
                       Background="#E3F2FD" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Productos" 
                                  FontSize="12"
                                  Foreground="#1976D2"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.TotalProductos}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#1565C0"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Valor Total -->
                <Border Grid.Column="1" 
                       Background="#E8F5E9" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Valor Total" 
                                  FontSize="12"
                                  Foreground="#388E3C"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.ValorTotalInventario, StringFormat=C}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#2E7D32"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stock Bajo -->
                <Border Grid.Column="2" 
                       Background="#FFF3E0" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Stock Bajo" 
                                  FontSize="12"
                                  Foreground="#F57C00"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.ProductosStockBajo}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#EF6C00"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Sin Stock -->
                <Border Grid.Column="3" 
                       Background="#FFEBEE" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Sin Stock" 
                                  FontSize="12"
                                  Foreground="#C62828"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.ProductosSinStock}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#B71C1C"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Rotación Promedio -->
                <Border Grid.Column="4" 
                       Background="#F3E5F5" 
                       CornerRadius="8"
                       Padding="15">
                    <StackPanel>
                        <TextBlock Text="Rotación Prom." 
                                  FontSize="12"
                                  Foreground="#7B1FA2"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.RotacionPromedio, StringFormat='{}{0:N1}x'}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#6A1B9A"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Contenedor principal de filtros y datos -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filtros (siempre visibles cuando hay resumen) -->
            <Border Grid.Row="0" 
                   Background="#FAFAFA"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,0,0,1"
                   Padding="20,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍 Filtrar:" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              FontWeight="SemiBold"
                              Foreground="Gray"/>
                    
                    <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                            Width="300"
                            Padding="8"
                            FontSize="13"
                            BorderBrush="#BDBDBD"
                            BorderThickness="1"
                            Margin="0,0,20,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Buscar por código, nombre o categoría..." 
                                                                  Foreground="#BDBDBD" 
                                                                  Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="Estado:" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              FontWeight="SemiBold"
                              Foreground="Gray"/>
                    
                    <ComboBox ItemsSource="{Binding OpcionesEstado}"
                             SelectedItem="{Binding FiltroEstado}"
                             Width="150"
                             Padding="8"
                             FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- DataGrid con su propio control de visibilidad -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Productos.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       Margin="20"
                       CornerRadius="5">
                    <DataGrid ItemsSource="{Binding Productos}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             RowHeight="40"
                             FontSize="13"
                             Background="White"
                             BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF5722"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" 
                                               Binding="{Binding Codigo}" 
                                               Width="100"/>
                            <DataGridTextColumn Header="Producto" 
                                               Binding="{Binding Nombre}" 
                                               Width="*"/>
                            <DataGridTextColumn Header="Categoría" 
                                               Binding="{Binding Categoria}" 
                                               Width="130"/>
                            <DataGridTextColumn Header="Stock" 
                                               Binding="{Binding StockActual}" 
                                               Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Min." 
                                               Binding="{Binding StockMinimo}" 
                                               Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Precio Compra" 
                                               Binding="{Binding PrecioCompra, StringFormat=C}" 
                                               Width="120"/>
                            <DataGridTextColumn Header="Precio Venta" 
                                               Binding="{Binding PrecioVenta, StringFormat=C}" 
                                               Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Valor Total" 
                                               Binding="{Binding ValorInventario, StringFormat=C}" 
                                               Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FF9800"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Rotación" 
                                               Binding="{Binding RotacionInventario, StringFormat='{}{0:N1}x'}" 
                                               Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Estado" 
                                               Binding="{Binding EstadoStock}" 
                                               Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstadoStock}" Value="Sin Stock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="#F44336"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EstadoStock}" Value="Stock Bajo">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                                <Setter Property="Background" Value="#FFE0B2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EstadoStock}" Value="Stock Normal">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Setter Property="Background" Value="#C8E6C9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Mensaje cuando el filtro no devuelve resultados -->
            <StackPanel Grid.Row="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Productos.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                            <!-- Ocultar si no hay resumen (estado inicial) -->
                            <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <TextBlock Text="🔍" 
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,15"
                          Opacity="0.4"/>
                <TextBlock Text="No se encontraron productos con los filtros aplicados" 
                          FontSize="15"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Intente cambiar los criterios de búsqueda" 
                          FontSize="13"
                          Foreground="#BDBDBD"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
               Grid.RowSpan="4"
               Background="#80000000"
               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Cargando inventario..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mensaje cuando no hay datos (estado inicial) -->
        <StackPanel Grid.Row="3"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <TextBlock Text="📦" 
                      FontSize="64"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Opacity="0.3"/>
            <TextBlock Text="Genere el reporte para ver el inventario completo" 
                      FontSize="16"
                      Foreground="Gray"
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>