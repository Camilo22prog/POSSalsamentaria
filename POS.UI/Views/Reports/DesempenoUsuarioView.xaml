<UserControl x:Class="POS.UI.Views.Reports.DesempenoUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DesempenoUsuarioViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#2196F3" 
                Padding="20">
            <TextBlock>
                <Run Text="👤" FontSize="24"/>
                <Run Text=" DESEMPEÑO POR USUARIO" 
                     FontSize="20" 
                     FontWeight="Bold"
                     Foreground="White"/>
            </TextBlock>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" 
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fecha Inicio:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <TextBlock Text="Fecha Fin:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaFin, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <Button Content="🔍 Generar Reporte"
                       Padding="20,10"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding GenerarReporteCommand}"/>

                <Button Content="📥 Exportar Excel"
                       Padding="20,10"
                       Margin="10,0,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#FF9800"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding ExportarExcelCommand}"/>

                <!-- Rangos rápidos -->
                <TextBlock Text="Rangos:" 
                          VerticalAlignment="Center"
                          Margin="30,0,10,0"
                          FontWeight="SemiBold"
                          Foreground="Gray"/>
                
                <Button Content="Hoy" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Hoy"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Semana" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Semana"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Mes" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Mes"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Año" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Año"
                       Padding="10,5"
                       FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Resumen Ejecutivo -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Usuarios -->
                <Border Grid.Column="0" 
                       Background="#E3F2FD" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Usuarios" 
                                  FontSize="12"
                                  Foreground="#1976D2"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.TotalUsuarios}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#1565C0"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Ventas -->
                <Border Grid.Column="1" 
                       Background="#E8F5E9" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Ventas" 
                                  FontSize="12"
                                  Foreground="#388E3C"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.TotalVentas}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#2E7D32"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Ingresos -->
                <Border Grid.Column="2" 
                       Background="#FFF3E0" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Ingresos" 
                                  FontSize="12"
                                  Foreground="#F57C00"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.TotalIngresos, StringFormat=C}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#EF6C00"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Mejor Vendedor -->
                <Border Grid.Column="3" 
                       Background="#E8F5E9" 
                       CornerRadius="8"
                       Padding="15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="🏆" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Mejor Vendedor" 
                                      FontSize="12"
                                      Foreground="#388E3C"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Resumen.MejorVendedor}" 
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Foreground="#2E7D32"
                                  TextWrapping="Wrap"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Usuarios.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   Margin="20"
                   CornerRadius="5">
                <DataGrid ItemsSource="{Binding Usuarios}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowHeight="45"
                         FontSize="13"
                         Background="White"
                         BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2196F3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- Resaltar al mejor vendedor (primera fila) -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=AlternationIndex}" Value="0">
                                    <Setter Property="Background" Value="#C8E6C9"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" 
                                           Binding="{Binding NombreUsuario}" 
                                           Width="120"/>
                        <DataGridTextColumn Header="Nombre" 
                                           Binding="{Binding NombreCompleto}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Rol" 
                                           Binding="{Binding Rol}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Ventas" 
                                           Binding="{Binding CantidadVentas}" 
                                           Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="15"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total" 
                                           Binding="{Binding TotalVentas, StringFormat=C}" 
                                           Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="% Total" 
                                           Binding="{Binding PorcentajeVentas, StringFormat='{}{0:N1}%'}" 
                                           Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ticket Prom." 
                                           Binding="{Binding TicketPromedio, StringFormat=C}" 
                                           Width="110"/>
                        <DataGridTextColumn Header="Anuladas" 
                                           Binding="{Binding VentasAnuladas}" 
                                           Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#F44336"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="% Anul." 
                                           Binding="{Binding PorcentajeAnulacion, StringFormat='{}{0:N1}%'}" 
                                           Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Efectivo" 
                                           Binding="{Binding VentasEfectivo, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tarjeta" 
                                           Binding="{Binding VentasTarjeta, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Transfer." 
                                           Binding="{Binding VentasTransferencia, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nequi" 
                                           Binding="{Binding VentasNequi, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Daviplata" 
                                           Binding="{Binding VentasDaviplata, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="QR" 
                                           Binding="{Binding VentasQR, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ventas/Día" 
                                           Binding="{Binding VentasPorDia, StringFormat='{}{0:N1}'}" 
                                           Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
               Grid.RowSpan="4"
               Background="#80000000"
               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Generando reporte..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mensaje cuando no hay datos -->
        <StackPanel Grid.Row="3"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Usuarios.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <TextBlock Text="👤" 
                      FontSize="64"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Opacity="0.3"/>
            <TextBlock Text="Genere el reporte para ver el desempeño de usuarios" 
                      FontSize="16"
                      Foreground="Gray"
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>