<UserControl x:Class="POS.UI.Views.Reports.VentasPorClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:VentasPorClienteViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#9C27B0" 
                Padding="20">
            <TextBlock>
                <Run Text="👥" FontSize="24"/>
                <Run Text=" VENTAS POR CLIENTE" 
                     FontSize="20" 
                     FontWeight="Bold"
                     Foreground="White"/>
            </TextBlock>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" 
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Rango de fechas -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Fecha Inicio:" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}"
                               Width="140"
                               Margin="0,0,20,0"/>

                    <TextBlock Text="Fecha Fin:" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding FechaFin, Mode=TwoWay}"
                               Width="140"
                               Margin="0,0,20,0"/>

                    <Button Content="🔍 Generar Reporte"
                           Padding="20,10"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Background="#4CAF50"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"
                           Command="{Binding GenerarReporteCommand}"/>

                    <Button Content="📥 Exportar Excel"
                        Padding="20,10"
                        Margin="10,0,0,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#FF9800"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ExportarExcelCommand}"/>
                </StackPanel>

                <!-- Filtro de búsqueda y rangos rápidos -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Búsqueda -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="🔍 Filtrar:" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  FontWeight="SemiBold"
                                  Foreground="Gray"/>
                        
                        <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                                Width="250"
                                Padding="8"
                                FontSize="13"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Buscar por nombre o documento..." 
                                                                      Foreground="#BDBDBD" 
                                                                      Margin="5,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <!-- Rangos rápidos -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Rangos:" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  FontWeight="SemiBold"
                                  Foreground="Gray"/>
                        
                        <Button Content="Hoy" 
                               Command="{Binding EstablecerRangoRapidoCommand}"
                               CommandParameter="Hoy"
                               Padding="10,5" Margin="0,0,5,0"
                               FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                        
                        <Button Content="Semana" 
                               Command="{Binding EstablecerRangoRapidoCommand}"
                               CommandParameter="Semana"
                               Padding="10,5" Margin="0,0,5,0"
                               FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                        
                        <Button Content="Mes" 
                               Command="{Binding EstablecerRangoRapidoCommand}"
                               CommandParameter="Mes"
                               Padding="10,5" Margin="0,0,5,0"
                               FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                        
                        <Button Content="Año" 
                               Command="{Binding EstablecerRangoRapidoCommand}"
                               CommandParameter="Año"
                               Padding="10,5"
                               FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2"
               BorderBrush="#E0E0E0"
               BorderThickness="1"
               Margin="20"
               CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Clientes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <DataGrid ItemsSource="{Binding Clientes}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column"
                     RowHeight="40"
                     FontSize="13"
                     Background="White"
                     BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#9C27B0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cliente" 
                                       Binding="{Binding ClienteNombre}" 
                                       Width="*"/>
                    <DataGridTextColumn Header="Documento" 
                                       Binding="{Binding NumeroDocumento}" 
                                       Width="130"/>
                    <DataGridTextColumn Header="# Compras" 
                                       Binding="{Binding CantidadCompras}" 
                                       Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total Compras" 
                                       Binding="{Binding TotalCompras, StringFormat=C}" 
                                       Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ticket Promedio" 
                                       Binding="{Binding TicketPromedio, StringFormat=C}" 
                                       Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#FF9800"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Última Compra" 
                                       Binding="{Binding UltimaCompra, StringFormat='dd/MM/yyyy'}" 
                                       Width="120"/>
                    <DataGridTextColumn Header="Días" 
                                       Binding="{Binding DiasDesdeUltimaCompra}" 
                                       Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="Gray"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
               Grid.RowSpan="3"
               Background="#80000000"
               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Generando reporte..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mensaje cuando no hay datos -->
        <StackPanel Grid.Row="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Clientes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <TextBlock Text="👥" 
                      FontSize="64"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Opacity="0.3"/>
            <TextBlock Text="Genere un reporte para ver el análisis de clientes" 
                      FontSize="16"
                      Foreground="Gray"
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>