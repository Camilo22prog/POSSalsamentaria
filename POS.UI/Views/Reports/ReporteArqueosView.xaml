<UserControl x:Class="POS.UI.Views.Reports.ReporteArqueosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ReporteArqueosViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#FFC107" 
                Padding="20">
            <TextBlock>
                <Run Text="💰" FontSize="24"/>
                <Run Text=" REPORTE DE ARQUEOS DE CAJA" 
                     FontSize="20" 
                     FontWeight="Bold"
                     Foreground="White"/>
            </TextBlock>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" 
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fecha Inicio:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <TextBlock Text="Fecha Fin:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaFin, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <Button Content="🔍 Generar Reporte"
                       Padding="20,10"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding GenerarReporteCommand}"/>

                <Button Content="📥 Exportar Excel"
                       Padding="20,10"
                       Margin="10,0,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#FF9800"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding ExportarExcelCommand}"/>

                <!-- Rangos rápidos -->
                <TextBlock Text="Rangos:" 
                          VerticalAlignment="Center"
                          Margin="30,0,10,0"
                          FontWeight="SemiBold"
                          Foreground="Gray"/>
                
                <Button Content="Hoy" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Hoy"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#FFF3E0" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Semana" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Semana"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#FFF3E0" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Mes" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Mes"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#FFF3E0" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Año" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Año"
                       Padding="10,5"
                       FontSize="11" Background="#FFF3E0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Resumen Ejecutivo -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Arqueos -->
                <Border Grid.Column="0" 
                       Background="#FFF8E1" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Arqueos" 
                                  FontSize="12"
                                  Foreground="#F57F17"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.TotalArqueos}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#F57F17"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Ingresos -->
                <Border Grid.Column="1" 
                       Background="#E8F5E9" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Ingresos" 
                                  FontSize="12"
                                  Foreground="#388E3C"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.TotalIngresos, StringFormat=C}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#2E7D32"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Saldo Neto -->
                <Border Grid.Column="2" 
                       Background="#E3F2FD" 
                       CornerRadius="8"
                       Padding="15"
                       Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Saldo Neto" 
                                  FontSize="12"
                                  Foreground="#1976D2"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resumen.SaldoNeto, StringFormat=C}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#1565C0"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Diferencia Total -->
                <Border Grid.Column="3" 
                       CornerRadius="8"
                       Padding="15">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Resumen.DiferenciaTotal}" Value="0">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Diferencia Total" 
                                  FontSize="12"
                                  FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Resumen.DiferenciaTotal}" Value="0">
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Resumen.DiferenciaTotal, StringFormat=C}" 
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#B71C1C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Resumen.DiferenciaTotal}" Value="0">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Arqueos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   Margin="20"
                   CornerRadius="5">
                <DataGrid ItemsSource="{Binding Arqueos}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowHeight="45"
                         FontSize="13"
                         Background="White"
                         BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FFC107"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha Apertura" 
                                           Binding="{Binding FechaApertura, StringFormat='dd/MM/yyyy HH:mm'}" 
                                           Width="140"/>
                        <DataGridTextColumn Header="Fecha Cierre" 
                                           Binding="{Binding FechaCierre, StringFormat='dd/MM/yyyy HH:mm'}" 
                                           Width="140"/>
                        <DataGridTextColumn Header="Usuario" 
                                           Binding="{Binding NombreUsuario}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Estado" 
                                           Binding="{Binding EstadoCaja}" 
                                           Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="5,3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstadoCaja}" Value="Abierta">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstadoCaja}" Value="Cerrada">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#9E9E9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Monto Inicial" 
                                           Binding="{Binding MontoInicial, StringFormat=C}" 
                                           Width="110"/>
                        <DataGridTextColumn Header="Efectivo" 
                                           Binding="{Binding TotalEfectivo, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tarjeta" 
                                           Binding="{Binding TotalTarjeta, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#2196F3"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Transfer." 
                                           Binding="{Binding TotalTransferencia, StringFormat=C}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#9C27B0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total Ventas" 
                                           Binding="{Binding TotalVentas, StringFormat=C}" 
                                           Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Esperado" 
                                           Binding="{Binding MontoEsperado, StringFormat=C}" 
                                           Width="110"/>
                        <DataGridTextColumn Header="Contado" 
                                           Binding="{Binding MontoContado, StringFormat=C}" 
                                           Width="110"/>
                        <DataGridTextColumn Header="Diferencia" 
                                        Binding="{Binding Diferencia, StringFormat=C}" 
                                        Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#F44336"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Diferencia}" Value="0">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tipo" 
                                        Binding="{Binding TipoDiferencia}" 
                                        Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="5,3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TipoDiferencia}" Value="Cuadrado">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TipoDiferencia}" Value="Excedente">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#2196F3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TipoDiferencia}" Value="Faltante">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#F44336"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="# Ventas" 
                                           Binding="{Binding NumeroVentas}" 
                                           Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
               Grid.RowSpan="4"
               Background="#80000000"
               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Generando reporte..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mensaje cuando no hay datos -->
        <StackPanel Grid.Row="3"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Arqueos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <TextBlock Text="💰" 
                      FontSize="64"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Opacity="0.3"/>
            <TextBlock Text="Genere el reporte para ver los arqueos de caja" 
                      FontSize="16"
                      Foreground="Gray"
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>