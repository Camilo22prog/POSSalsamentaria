<UserControl x:Class="POS.UI.Views.Reports.VentasAnuladasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:VentasAnuladasViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#F44336" 
                Padding="20">
            <TextBlock>
                <Run Text="🔄" FontSize="24"/>
                <Run Text=" VENTAS ANULADAS" 
                     FontSize="20" 
                     FontWeight="Bold"
                     Foreground="White"/>
            </TextBlock>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" 
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fecha Inicio:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <TextBlock Text="Fecha Fin:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaFin, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <Button Content="🔍 Generar Reporte"
                       Padding="20,10"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding GenerarReporteCommand}"/>

                <Button Content="📥 Exportar Excel"
                       Padding="20,10"
                       Margin="10,0,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#FF9800"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding ExportarExcelCommand}"/>

                <!-- Rangos rápidos -->
                <TextBlock Text="Rangos:" 
                          VerticalAlignment="Center"
                          Margin="30,0,10,0"
                          FontWeight="SemiBold"
                          Foreground="Gray"/>
                
                <Button Content="Hoy" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Hoy"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#FFCDD2" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Semana" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Semana"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#FFCDD2" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Mes" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Mes"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#FFCDD2" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Año" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Año"
                       Padding="10,5"
                       FontSize="11" Background="#FFCDD2" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Resumen Ejecutivo -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Primera fila de cards -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Anuladas -->
                    <Border Grid.Column="0" 
                           Background="#FFEBEE" 
                           CornerRadius="8"
                           Padding="15"
                           Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Ventas Anuladas" 
                                      FontSize="12"
                                      Foreground="#C62828"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Resumen.TotalVentasAnuladas}" 
                                      FontSize="28"
                                      FontWeight="Bold"
                                      Foreground="#B71C1C"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Monto Perdido -->
                    <Border Grid.Column="1" 
                           Background="#FFEBEE" 
                           CornerRadius="8"
                           Padding="15"
                           Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Monto Perdido" 
                                      FontSize="12"
                                      Foreground="#C62828"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Resumen.MontoTotalAnulado, StringFormat=C}" 
                                      FontSize="24"
                                      FontWeight="Bold"
                                      Foreground="#B71C1C"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- % Anulación -->
                    <Border Grid.Column="2" 
                           Background="#FFF3E0" 
                           CornerRadius="8"
                           Padding="15"
                           Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="% Anulación" 
                                      FontSize="12"
                                      Foreground="#E65100"
                                      FontWeight="SemiBold"/>
                            <TextBlock FontSize="24"
                                      FontWeight="Bold"
                                      Foreground="#EF6C00"
                                      Margin="0,5,0,0">
                                <Run Text="{Binding Resumen.PorcentajeAnulacion, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                                <Run Text="%" FontSize="18"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Total Ventas -->
                    <Border Grid.Column="3" 
                           Background="#E3F2FD" 
                           CornerRadius="8"
                           Padding="15">
                        <StackPanel>
                            <TextBlock Text="Total Ventas Período" 
                                      FontSize="12"
                                      Foreground="#1976D2"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Resumen.VentasTotales}" 
                                      FontSize="24"
                                      FontWeight="Bold"
                                      Foreground="#1565C0"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Segunda fila - Usuario con más anulaciones -->
                <Border Grid.Row="2"
                       Background="#FFCDD2" 
                       CornerRadius="8"
                       Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                  Text="⚠️" 
                                  FontSize="28"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Usuario con más anulaciones" 
                                      FontSize="11"
                                      Foreground="#C62828"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Resumen.UsuarioConMasAnulaciones}" 
                                      FontSize="16"
                                      FontWeight="Bold"
                                      Foreground="#B71C1C"
                                      Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                               Background="#F44336"
                               CornerRadius="20"
                               Padding="15,8"
                               VerticalAlignment="Center">
                            <TextBlock FontWeight="Bold" Foreground="White">
                                <Run Text="{Binding Resumen.CantidadMasAnulaciones, Mode=OneWay}"/>
                                <Run Text=" anulaciones" FontSize="11"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Ventas.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   Margin="20"
                   CornerRadius="5">
                <DataGrid ItemsSource="{Binding Ventas}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowHeight="45"
                         FontSize="13"
                         Background="White"
                         BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F44336"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="# Venta" 
                                           Binding="{Binding NumeroVenta}" 
                                           Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Fecha Venta" 
                                           Binding="{Binding FechaVenta, StringFormat='dd/MM/yyyy HH:mm'}" 
                                           Width="140"/>
                        <DataGridTextColumn Header="Fecha Anulación" 
                                           Binding="{Binding FechaAnulacion, StringFormat='dd/MM/yyyy HH:mm'}" 
                                           Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#F44336"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cliente" 
                                           Binding="{Binding Cliente}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Usuario" 
                                           Binding="{Binding Usuario}" 
                                           Width="150"/>
                        <DataGridTextColumn Header="Monto" 
                                           Binding="{Binding Total, StringFormat=C}" 
                                           Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#F44336"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Método" 
                                           Binding="{Binding MetodoPago}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Productos" 
                                           Binding="{Binding CantidadProductos}" 
                                           Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tiempo (min)" 
                                           Binding="{Binding TiempoHastaAnulacion}" 
                                           Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Motivo" 
                                           Binding="{Binding MotivoAnulacion}" 
                                           Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="Foreground" Value="#757575"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
               Grid.RowSpan="4"
               Background="#80000000"
               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Generando reporte..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mensaje cuando no hay datos -->
        <StackPanel Grid.Row="3"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Ventas.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <TextBlock Text="✅" 
                      FontSize="64"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Opacity="0.3"/>
            <TextBlock Text="No hay ventas anuladas en este período" 
                      FontSize="16"
                      Foreground="Gray"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="¡Excelente trabajo del equipo!" 
                      FontSize="13"
                      Foreground="#4CAF50"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                      Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>