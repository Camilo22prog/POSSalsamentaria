<UserControl x:Class="POS.UI.Views.Reports.AnalisisABCView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:POS.UI.ViewModels.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:AnalisisABCViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#9C27B0" 
                Padding="20">
            <TextBlock>
                <Run Text="🔤" FontSize="24"/>
                <Run Text=" ANÁLISIS ABC DE PRODUCTOS" 
                     FontSize="20" 
                     FontWeight="Bold"
                     Foreground="White"/>
            </TextBlock>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" 
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fecha Inicio:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <TextBlock Text="Fecha Fin:" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding FechaFin, Mode=TwoWay}"
                           Width="140"
                           Margin="0,0,20,0"/>

                <Button Content="🔍 Generar Reporte"
                       Padding="20,10"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding GenerarReporteCommand}"/>

                <Button Content="📥 Exportar Excel"
                       Padding="20,10"
                       Margin="10,0,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Background="#FF9800"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding ExportarExcelCommand}"/>

                <!-- Rangos rápidos -->
                <TextBlock Text="Rangos:" 
                          VerticalAlignment="Center"
                          Margin="30,0,10,0"
                          FontWeight="SemiBold"
                          Foreground="Gray"/>
                
                <Button Content="Mes" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Mes"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Trimestre" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Trimestre"
                       Padding="10,5" Margin="0,0,5,0"
                       FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="Año" 
                       Command="{Binding EstablecerRangoRapidoCommand}"
                       CommandParameter="Año"
                       Padding="10,5"
                       FontSize="11" Background="#E3F2FD" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Resumen por Clasificación -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Clase A -->
                <Border Grid.Column="0" 
                       Background="#E8F5E9" 
                       CornerRadius="10"
                       Padding="20"
                       Margin="0,0,15,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#4CAF50"
                                   CornerRadius="20"
                                   Padding="12,6"
                                   Margin="0,0,10,0">
                                <TextBlock Text="CLASE A" 
                                          FontSize="14"
                                          FontWeight="Bold"
                                          Foreground="White"/>
                            </Border>
                            <TextBlock Text="Top Performers" 
                                      FontSize="11"
                                      Foreground="Gray"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Productos" 
                                          FontSize="12"
                                          Foreground="#2E7D32"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Resumen.ProductosA}" 
                                          FontSize="32"
                                          FontWeight="Bold"
                                          Foreground="#1B5E20"
                                          Margin="0,5,0,0"/>
                                <TextBlock FontSize="11" Foreground="Gray" Margin="0,5,0,0">
                                    <Run Text="{Binding Resumen.PorcentajeA, StringFormat='{}{0:N1}%', Mode=OneWay}"/>
                                    <Run Text=" de ventas"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ventas" 
                                          FontSize="10"
                                          Foreground="#2E7D32"
                                          HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Resumen.VentasA, StringFormat=C}" 
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="#1B5E20"
                                          HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Clase B -->
                <Border Grid.Column="1" 
                       Background="#FFF3E0" 
                       CornerRadius="10"
                       Padding="20"
                       Margin="0,0,15,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#FF9800"
                                   CornerRadius="20"
                                   Padding="12,6"
                                   Margin="0,0,10,0">
                                <TextBlock Text="CLASE B" 
                                          FontSize="14"
                                          FontWeight="Bold"
                                          Foreground="White"/>
                            </Border>
                            <TextBlock Text="Moderados" 
                                      FontSize="11"
                                      Foreground="Gray"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Productos" 
                                          FontSize="12"
                                          Foreground="#E65100"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Resumen.ProductosB}" 
                                          FontSize="32"
                                          FontWeight="Bold"
                                          Foreground="#E65100"
                                          Margin="0,5,0,0"/>
                                <TextBlock FontSize="11" Foreground="Gray" Margin="0,5,0,0">
                                    <Run Text="{Binding Resumen.PorcentajeB, StringFormat='{}{0:N1}%', Mode=OneWay}"/>
                                    <Run Text=" de ventas"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ventas" 
                                          FontSize="10"
                                          Foreground="#E65100"
                                          HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Resumen.VentasB, StringFormat=C}" 
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="#E65100"
                                          HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Clase C -->
                <Border Grid.Column="2" 
                       Background="#FFEBEE" 
                       CornerRadius="10"
                       Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#F44336"
                                   CornerRadius="20"
                                   Padding="12,6"
                                   Margin="0,0,10,0">
                                <TextBlock Text="CLASE C" 
                                          FontSize="14"
                                          FontWeight="Bold"
                                          Foreground="White"/>
                            </Border>
                            <TextBlock Text="Bajo Volumen" 
                                      FontSize="11"
                                      Foreground="Gray"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Productos" 
                                          FontSize="12"
                                          Foreground="#C62828"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Resumen.ProductosC}" 
                                          FontSize="32"
                                          FontWeight="Bold"
                                          Foreground="#B71C1C"
                                          Margin="0,5,0,0"/>
                                <TextBlock FontSize="11" Foreground="Gray" Margin="0,5,0,0">
                                    <Run Text="{Binding Resumen.PorcentajeC, StringFormat='{}{0:N1}%', Mode=OneWay}"/>
                                    <Run Text=" de ventas"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ventas" 
                                          FontSize="10"
                                          Foreground="#C62828"
                                          HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Resumen.VentasC, StringFormat=C}" 
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="#B71C1C"
                                          HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filtro y DataGrid -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filtro por clasificación -->
            <Border Grid.Row="0" 
                   Background="#FAFAFA"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,0,0,1"
                   Padding="20,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍 Filtrar por Clasificación:" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              FontWeight="SemiBold"
                              Foreground="Gray"/>
                    
                    <ComboBox ItemsSource="{Binding OpcionesClasificacion}"
                             SelectedItem="{Binding FiltroClasificacion}"
                             Width="150"
                             Padding="8"
                             FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Productos.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border BorderBrush="#E0E0E0"
                       BorderThickness="1"
                       Margin="20"
                       CornerRadius="5">
                    <DataGrid ItemsSource="{Binding Productos}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             RowHeight="40"
                             FontSize="13"
                             Background="White"
                             BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#9C27B0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Clase" 
                                               Binding="{Binding ClasificacionABC}" 
                                               Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClasificacionABC}" Value="A">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="#4CAF50"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClasificacionABC}" Value="B">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="#FF9800"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClasificacionABC}" Value="C">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Código" 
                                               Binding="{Binding Codigo}" 
                                               Width="100"/>
                            <DataGridTextColumn Header="Producto" 
                                               Binding="{Binding Nombre}" 
                                               Width="*"/>
                            <DataGridTextColumn Header="Categoría" 
                                               Binding="{Binding Categoria}" 
                                               Width="130"/>
                            <DataGridTextColumn Header="Cant. Vendida" 
                                               Binding="{Binding CantidadVendida}" 
                                               Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total Ventas" 
                                               Binding="{Binding TotalVentas, StringFormat=C}" 
                                               Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="% Ventas" 
                                               Binding="{Binding PorcentajeVentas, StringFormat='{}{0:N2}%'}" 
                                               Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="% Acum." 
                                               Binding="{Binding PorcentajeAcumulado, StringFormat='{}{0:N2}%'}" 
                                               Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Utilidad" 
                                               Binding="{Binding UtilidadTotal, StringFormat=C}" 
                                               Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FF9800"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Stock" 
                                               Binding="{Binding StockActual}" 
                                               Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Rotación" 
                                               Binding="{Binding RotacionInventario, StringFormat='{}{0:N1}x'}" 
                                               Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Mensaje cuando el filtro no devuelve resultados -->
            <StackPanel Grid.Row="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Productos.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <TextBlock Text="🔍" 
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,15"
                          Opacity="0.4"/>
                <TextBlock Text="No hay productos en esta clasificación" 
                          FontSize="15"
                          Foreground="Gray"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
               Grid.RowSpan="4"
               Background="#80000000"
               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Generando análisis ABC..."
                          FontSize="18"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mensaje cuando no hay datos -->
        <StackPanel Grid.Row="3"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resumen}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <TextBlock Text="🔤" 
                      FontSize="64"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Opacity="0.3"/>
            <TextBlock Text="Genere el análisis ABC para clasificar sus productos" 
                      FontSize="16"
                      Foreground="Gray"
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>